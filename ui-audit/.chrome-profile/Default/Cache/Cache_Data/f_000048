ert-success {\r\n  background-color: #ECFDF5;\r\n  border-color: #A7F3D0;\r\n}\r\n\r\n.qd-alert-info {\r\n  background-color: #EFF6FF;\r\n  border-color: #BFDBFE;\r\n}\r\n\r\n.qd-alert-title {\r\n  font-weight: 700;\r\n  display: block;\r\n  line-height: 1.25;\r\n}\r\n\r\n.qd-alert-desc {\r\n  font-size: 10px;\r\n  margin-top: 1px;\r\n  line-height: 1.3;\r\n}\r\n\r\n\r\n\r\n/* ==========================================================================\r\n   Split-Screen Login Page Styles\r\n   Left Half: Logos, College Name, Branding & Accreditations\r\n   Right Half: Authentication Form, Role Selectors & Fast Pass\r\n   ========================================================================== */\r\n\r\n.split-login-container {\r\n  display: flex;\r\n  min-height: 100vh;\r\n  width: 100%;\r\n  background-color: var(--bg-canvas);\r\n  position: relative;\r\n  overflow-x: hidden;\r\n}\r\n\r\n@media (max-width: 1023px) {\r\n  .split-login-container {\r\n    flex-direction: column;\r\n  }\r\n}\r\n\r\n/* Brand Half (Left Half) */\r\n.split-login-brand {\r\n  position: relative;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  padding: 3rem 2.5rem;\r\n  background: linear-gradient(135deg, #071329 0%, #0c2049 45%, #1d4ed8 100%);\r\n  color: #FFFFFF;\r\n  overflow: hidden;\r\n  box-sizing: border-box;\r\n}\r\n\r\n@media (min-width: 1024px) {\r\n  .split-login-brand {\r\n    width: 50%;\r\n    min-height: 100vh;\r\n    padding: 3.5rem 3.5rem;\r\n    position: sticky;\r\n    top: 0;\r\n  }\r\n}\r\n\r\n@media (max-width: 1023px) {\r\n  .split-login-brand {\r\n    display: none !important;\r\n  }\r\n}\r\n\r\n/* Responsive Mobile-Only Header on Login Page */\r\n.mobile-login-logo {\r\n  display: none;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  text-align: center;\r\n  margin-bottom: 1.5rem;\r\n}\r\n\r\n.mobile-logo-circle {\r\n  width: 76px;\r\n  height: 76px;\r\n  border-radius: var(--radius-2xl);\r\n  background-color: #FFFFFF;\r\n  padding: 0.5rem;\r\n  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.05);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  margin-bottom: 0.75rem;\r\n}\r\n\r\n.mobile-logo-circle img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: contain;\r\n}\r\n\r\n.mobile-login-logo h3 {\r\n  font-size: 16px;\r\n  font-weight: 800;\r\n  color: #0F172A;\r\n  margin: 0;\r\n  line-height: 1.25;\r\n}\r\n\r\n.mobile-login-logo p {\r\n  font-size: 12px;\r\n  color: #64748B;\r\n  margin-top: 3px;\r\n  font-weight: 500;\r\n}\r\n\r\n@media (max-width: 1023px) {\r\n  .mobile-login-logo {\r\n    display: flex !important;\r\n  }\r\n\r\n  .split-login-form-area {\r\n    padding: 2.5rem 1.25rem !important;\r\n    min-height: 100vh;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n  }\r\n}\r\n\r\n/* Background Ambient Orbs */\r\n.split-login-brand::before {\r\n  content: '';\r\n  position: absolute;\r\n  top: -120px;\r\n  right: -120px;\r\n  width: 420px;\r\n  height: 420px;\r\n  border-radius: 50%;\r\n  background: radial-gradient(circle, rgba(59, 130, 246, 0.35) 0%, transparent 70%);\r\n  pointer-events: none;\r\n}\r\n\r\n.split-login-brand::after {\r\n  content: '';\r\n  position: absolute;\r\n  bottom: -150px;\r\n  left: -150px;\r\n  width: 500px;\r\n  height: 500px;\r\n  border-radius: 50%;\r\n  background: radial-gradient(circle, rgba(14, 165, 233, 0.25) 0%, transparent 70%);\r\n  pointer-events: none;\r\n}\r\n\r\n/* Brand Logo Emblem Box */\r\n.brand-emblem-box {\r\n  width: 80px;\r\n  height: 80px;\r\n  border-radius: var(--radius-2xl);\r\n  background-color: #FFFFFF;\r\n  padding: 0.65rem;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.2);\r\n  flex-shrink: 0;\r\n  transition: transform 0.2s ease;\r\n}\r\n\r\n.brand-emblem-box:hover {\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.brand-emblem-img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: contain;\r\n}\r\n\r\n/* Accreditation Pills */\r\n.accreditation-pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.4rem;\r\n  padding: 0.35rem 0.85rem;\r\n  border-radius: var(--radius-full);\r\n  background: rgba(255, 255, 255, 0.12);\r\n  backdrop-filter: blur(10px);\r\n  border: 1px solid rgba(255, 255, 255, 0.2);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  color: #E2E8F0;\r\n  letter-spacing: 0.02em;\r\n}\r\n\r\n/* Glass Feature Card */\r\n.brand-feature-card {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 0.85rem;\r\n  padding: 0.85rem 1rem;\r\n  border-radius: var(--radius-xl);\r\n  background: rgba(255, 255, 255, 0.07);\r\n  backdrop-filter: blur(12px);\r\n  border: 1px solid rgba(255, 255, 255, 0.14);\r\n  transition: background 0.2s ease, transform 0.2s ease;\r\n}\r\n\r\n.brand-feature-card:hover {\r\n  background: rgba(255, 255, 255, 0.11);\r\n  transform: translateX(4px);\r\n}\r\n\r\n.brand-feature-icon {\r\n  width: 36px;\r\n  height: 36px;\r\n  border-radius: var(--radius-lg);\r\n  background: rgba(255, 255, 255, 0.15);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #93C5FD;\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* Form Half (Right Half) */\r\n.split-login-form-side {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 2.5rem 1.5rem;\r\n  background-color: var(--bg-canvas);\r\n  box-sizing: border-box;\r\n}\r\n\r\n@media (min-width: 1024px) {\r\n  .split-login-form-side {\r\n    width: 50%;\r\n    min-height: 100vh;\r\n    padding: 3.5rem 3rem;\r\n  }\r\n}\r\n\r\n.split-form-wrapper {\r\n  max-width: 480px;\r\n  width: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1.25rem;\r\n}\r\n\r\n/* Smart SSO Role Switcher Buttons on Login */\r\n.login-role-tab {\r\n  padding: 0.4rem 0.85rem;\r\n  border-radius: var(--radius-full);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  white-space: nowrap;\r\n  transition: all 0.18s ease;\r\n  cursor: pointer;\r\n  border: 1px solid transparent;\r\n}\r\n\r\n.login-role-tab.active {\r\n  background-color: var(--primary);\r\n  color: #FFFFFF;\r\n  box-shadow: 0 2px 8px rgba(29, 78, 216, 0.25);\r\n}\r\n\r\n.login-role-tab:not(.active) {\r\n  background-color: var(--surface);\r\n  color: var(--text-secondary);\r\n  border-color: var(--border-subtle);\r\n}\r\n\r\n.login-role-tab:not(.active):hover {\r\n  background-color: var(--surface-high);\r\n  color: var(--text-primary);\r\n}\r\n\r\n/* ==========================================================================\r\n   Fixed Role Window Post-Login Header Indicator\r\n   ========================================================================== */\r\n\r\n.fixed-role-window-badge {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.65rem;\r\n  padding: 0.35rem 0.85rem;\r\n  border-radius: var(--radius-full);\r\n  background-color: var(--surface-low);\r\n  border: 1px solid var(--border-subtle);\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.fixed-role-window-badge:hover {\r\n  border-color: var(--border-focus);\r\n}\r\n\r\n.fixed-role-dot {\r\n  width: 8px;\r\n  height: 8px;\r\n  border-radius: 50%;\r\n  background-color: var(--secondary);\r\n  box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.2);\r\n}\r\n\r\n.fixed-role-text {\r\n  display: flex;\r\n  flex-direction: column;\r\n  line-height: 1.15;\r\n}\r\n\r\n.fixed-role-title {\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  color: var(--text-primary);\r\n  letter-spacing: 0.02em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.fixed-role-sub {\r\n  font-size: 10px;\r\n  color: var(--primary);\r\n  font-weight: 600;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .fixed-role-sub {\r\n    display: none;\r\n  }\r\n\r\n  .fixed-role-window-badge {\r\n    padding: 0.25rem 0.5rem;\r\n  }\r\n\r\n  .fixed-role-title {\r\n    font-size: 11px;\r\n  }\r\n}\r\n\r\n.switch-role-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.35rem;\r\n  padding: 0.35rem 0.75rem;\r\n  border-radius: var(--radius-full);\r\n  background-color: var(--surface-low);\r\n  border: 1px solid var(--border-subtle);\r\n  color: var(--text-secondary);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  transition: all 0.15s ease;\r\n}\r\n\r\n.switch-role-btn:hover {\r\n  background-color: var(--surface-high);\r\n  color: var(--text-primary);\r\n  border-color: var(--text-muted);\r\n}\r\n\r\n/* ==========================================================================\r\n   Fixed AI Dashboard & Dock System\r\n   ========================================================================== */\r\n\r\n:root {\r\n  --ai-dock-height: 88px;\r\n}\r\n\r\n/* Fixed AI Assistant Dock at bottom of screen */\r\n.ai-fixed-bottom-dashboard {\r\n  position: fixed;\r\n  bottom: 0;\r\n  left: 0;\r\n  right: 0;\r\n  z-index: 60;\r\n  background: rgba(255, 255, 255, 0.88);\r\n  backdrop-filter: blur(20px) saturate(180%);\r\n  -webkit-backdrop-filter: blur(20px) saturate(180%);\r\n  border-top: 1px solid rgba(226, 232, 240, 0.88);\r\n  border-top-left-radius: 24px;\r\n  border-top-right-radius: 24px;\r\n  box-shadow: 0 -8px 24px -4px rgba(15, 23, 42, 0.08), 0 -2px 6px -1px rgba(15, 23, 42, 0.04);\r\n  transition: left 0.32s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s ease;\r\n  pointer-events: auto;\r\n}\r\n\r\n@media (min-width: 1024px) {\r\n  .ai-fixed-bottom-dashboard.sidebar-open-offset {\r\n    left: var(--sidebar-width);\r\n  }\r\n}\r\n\r\n.ai-dock-container {\r\n  max-width: 1060px;\r\n  margin: 0 auto;\r\n  width: 100%;\r\n  padding: 0.65rem 1.75rem 0.45rem 1.75rem;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.35rem;\r\n}\r\n\r\n@media (max-width: 1023px) {\r\n  .ai-dock-container {\r\n    padding: 0.55rem 1.25rem 0.4rem 1.25rem;\r\n  }\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .ai-dock-container {\r\n    padding: 0.45rem 0.75rem 0.35rem 0.75rem;\r\n  }\r\n\r\n  .ai-fixed-bottom-dashboard {\r\n    border-top-left-radius: 18px;\r\n    border-top-right-radius: 18px;\r\n  }\r\n}\r\n\r\n/* Status banner for attached file or live listening */\r\n.ai-dock-status-bar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n  flex-wrap: wrap;\r\n  padding: 0 0.25rem;\r\n  animation: fadeIn 0.2s ease-out;\r\n}\r\n\r\n.ai-attachment-pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.35rem;\r\n  padding: 0.2rem 0.55rem 0.2rem 0.65rem;\r\n  background-color: var(--primary-container);\r\n  color: var(--primary);\r\n  border: 1px solid rgba(29, 78, 216, 0.15);\r\n  border-radius: var(--radius-full);\r\n  font-size: 11.5px;\r\n  max-width: 240px;\r\n}\r\n\r\n.ai-attachment-remove {\r\n  background: none;\r\n  border: none;\r\n  color: var(--text-secondary);\r\n  cursor: pointer;\r\n  padding: 2px;\r\n  border-radius: 50%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  transition: all 0.15s ease;\r\n}\r\n\r\n.ai-attachment-remove:hover {\r\n  background-color: rgba(239, 68, 68, 0.15);\r\n  color: #DC2626;\r\n}\r\n\r\n.ai-listening-pulse-banner {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.45rem;\r\n  padding: 0.2rem 0.65rem;\r\n  background-color: #FEF2F2;\r\n  border: 1px solid #FECACA;\r\n  border-radius: var(--radius-full);\r\n  animation: pulseGlow 1.5s infinite;\r\n}\r\n\r\n.ai-listening-dot {\r\n  width: 8px;\r\n  height: 8px;\r\n  border-radius: 50%;\r\n  background-color: #DC2626;\r\n  animation: pingDot 1s cubic-bezier(0, 0, 0.2, 1) infinite;\r\n}\r\n\r\n@keyframes pingDot {\r\n\r\n  75%,\r\n  100% {\r\n    transform: scale(1.6);\r\n    opacity: 0;\r\n  }\r\n}\r\n\r\n@keyframes pulseGlow {\r\n\r\n  0%,\r\n  100% {\r\n    box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.2);\r\n  }\r\n\r\n  50% {\r\n    box-shadow: 0 0 0 4px rgba(220, 38, 38, 0.2);\r\n  }\r\n}\r\n\r\n/* Main Form Row: 📎 | [ Type your message here... ] | 🎤 | ➤ */\r\n.ai-dock-form {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.45rem;\r\n  width: 100%;\r\n  background-color: rgba(248, 250, 252, 0.85);\r\n  border: 1px solid rgba(226, 232, 240, 0.95);\r\n  border-radius: 18px;\r\n  padding: 0.3rem 0.45rem;\r\n  box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.02);\r\n  transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;\r\n}\r\n\r\n.ai-dock-form:focus-within {\r\n  border-color: var(--primary);\r\n  background-color: #FFFFFF;\r\n  box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.12), inset 0 1px 2px rgba(15, 23, 42, 0.02);\r\n}\r\n\r\n/* Multiline Textarea wrapper */\r\n.ai-textarea-wrapper {\r\n  flex: 1;\r\n  min-width: 0;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.ai-multiline-textarea {\r\n  width: 100%;\r\n  background: transparent;\r\n  border: none;\r\n  outline: none;\r\n  resize: none;\r\n  font-family: var(--font-body);\r\n  font-size: 13.5px;\r\n  line-height: 1.45;\r\n  color: var(--text-primary);\r\n  padding: 0.4rem 0.5rem;\r\n  min-height: 38px;\r\n  max-height: 120px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.ai-multiline-textarea::placeholder {\r\n  color: #94A3B8;\r\n  font-size: 13px;\r\n}\r\n\r\n/* Dock Action Buttons */\r\n.ai-dock-btn {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 38px;\r\n  height: 38px;\r\n  min-width: 38px;\r\n  min-height: 38px;\r\n  border-radius: 12px;\r\n  border: none;\r\n  cursor: pointer;\r\n  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);\r\n  user-select: none;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.ai-dock-btn:active {\r\n  transform: scale(0.94);\r\n}\r\n\r\n.ai-dock-btn-attach {\r\n  color: var(--text-secondary);\r\n  background-color: transparent;\r\n}\r\n\r\n.ai-dock-btn-attach:hover {\r\n  background-color: rgba(226, 232, 240, 0.8);\r\n  color: var(--primary);\r\n  transform: scale(1.05);\r\n}\r\n\r\n.ai-dock-btn-attach.active {\r\n  background-color: var(--primary-container);\r\n  color: var(--primary);\r\n}\r\n\r\n.ai-dock-btn-mic {\r\n  color: var(--text-secondary);\r\n  background-color: transparent;\r\n}\r\n\r\n.ai-dock-btn-mic:hover {\r\n  background-color: rgba(226, 232, 240, 0.8);\r\n  color: var(--primary);\r\n  transform: scale(1.05);\r\n}\r\n\r\n.ai-dock-btn-mic.listening {\r\n  background-color: #FEE2E2;\r\n  color: #DC2626;\r\n  animation: micPulse 1.2s infinite;\r\n}\r\n\r\n@keyframes micPulse {\r\n\r\n  0%,\r\n  100% {\r\n    transform: scale(1);\r\n  }\r\n\r\n  50% {\r\n    transform: scale(1.08);\r\n  }\r\n}\r\n\r\n.ai-dock-btn-send.enabled {\r\n  background-color: var(--primary);\r\n  color: #FFFFFF;\r\n  box-shadow: 0 2px 8px rgba(29, 78, 216, 0.35);\r\n}\r\n\r\n.ai-dock-btn-send.enabled:hover {\r\n  background-color: var(--primary-hover);\r\n  transform: scale(1.06);\r\n  box-shadow: 0 4px 12px rgba(29, 78, 216, 0.45);\r\n}\r\n\r\n.ai-dock-btn-send.disabled {\r\n  background-color: #E2E8F0;\r\n  color: #94A3B8;\r\n  cursor: not-allowed;\r\n  opacity: 0.65;\r\n}\r\n\r\n/* Dock Bottom Footer / Branding Row */\r\n.ai-dock-footer {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0 0.35rem;\r\n  font-size: 11px;\r\n}\r\n\r\n.ai-dock-branding {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.35rem;\r\n  color: var(--text-muted);\r\n  font-size: 10.5px;\r\n  font-weight: 600;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .ai-dock-branding {\r\n    display: none;\r\n  }\r\n\r\n  .ai-dock-footer {\r\n    justify-content: flex-end;\r\n  }\r\n}\r\n\r\n.ai-history-toggle {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.3rem;\r\n  color: var(--primary);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  background: none;\r\n  border: none;\r\n  padding: 0;\r\n  transition: opacity 0.15s ease;\r\n}\r\n\r\n.ai-history-toggle:hover {\r\n  opacity: 0.85;\r\n  text-decoration: underline;\r\n}\r\n\r\n/* AI Assistant Response Drawer */\r\n.ai-response-drawer {\r\n  position: fixed;\r\n  bottom: 84px;\r\n  left: 0;\r\n  right: 0;\r\n  max-width: 900px;\r\n  margin: 0 auto 0.75rem auto;\r\n  z-index: 59;\r\n  background: rgba(255, 255, 255, 0.94);\r\n  backdrop-filter: blur(20px);\r\n  -webkit-backdrop-filter: blur(20px);\r\n  border: 1px solid rgba(226, 232, 240, 0.95);\r\n  border-radius: 20px;\r\n  box-shadow: 0 -8px 30px rgba(15, 23, 42, 0.12), 0 4px 12px rgba(15, 23, 42, 0.04);\r\n  display: flex;\r\n  flex-direction: column;\r\n  max-height: 480px;\r\n  animation: slideUpFade 0.25s cubic-bezier(0.16, 1, 0.3, 1);\r\n  overflow: hidden;\r\n  transition: left 0.32s cubic-bezier(0.16, 1, 0.3, 1);\r\n}\r\n\r\n@media (min-width: 1024px) {\r\n  .ai-response-drawer.sidebar-open-offset {\r\n    left: var(--sidebar-width);\r\n  }\r\n}\r\n\r\n@keyframes slideUpFade {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(12px) scale(0.98);\r\n  }\r\n\r\n  to {\r\n    opacity: 1;\r\n    transform: translateY(0) scale(1);\r\n  }\r\n}\r\n\r\n.ai-response-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0.75rem 1.15rem;\r\n  border-bottom: 1px solid var(--border-subtle);\r\n  background-color: rgba(248, 250, 252, 0.6);\r\n}\r\n\r\n.ai-bot-avatar {\r\n  width: 28px;\r\n  height: 28px;\r\n  border-radius: var(--radius-lg);\r\n  background-color: var(--primary-container);\r\n  color: var(--primary);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.ai-drawer-btn {\r\n  background: none;\r\n  border: none;\r\n  border-radius: var(--radius-md);\r\n  cursor: pointer;\r\n  transition: all 0.15s ease;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.ai-response-body {\r\n  padding: 1rem 1.15rem;\r\n  overflow-y: auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.75rem;\r\n  max-height: 380px;\r\n}\r\n\r\n.ai-empty-state {