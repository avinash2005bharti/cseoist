 1px solid var(--border-subtle);\r\n  display: flex;\r\n  flex-direction: column;\r\n  z-index: 95;\r\n  transform: translateX(-100%);\r\n  transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;\r\n  box-shadow: none;\r\n}\r\n\r\n.sidebar.sidebar-open,\r\n.sidebar-container.sidebar-open {\r\n  transform: translateX(0);\r\n  box-shadow: 6px 0 28px rgba(15, 23, 42, 0.12);\r\n}\r\n\r\n.sidebar.sidebar-closed,\r\n.sidebar-container.sidebar-closed {\r\n  transform: translateX(-100%);\r\n}\r\n\r\n@media (min-width: 1024px) {\r\n  .sidebar.sidebar-open,\r\n  .sidebar-container.sidebar-open {\r\n    box-shadow: 1px 0 0 0 var(--border-subtle);\r\n  }\r\n}\r\n\r\n\r\n\r\n/* Nav Link Item Shift */\r\n.sidebar-nav-item {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0.65rem 0.85rem;\r\n  border-radius: var(--radius-xl);\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  color: var(--text-secondary);\r\n  text-decoration: none;\r\n  transition: all 0.2s cubic-bezier(0.2, 0, 0, 1);\r\n  overflow: hidden;\r\n}\r\n\r\n.sidebar-nav-item:hover {\r\n  background-color: var(--slate-100);\r\n  color: var(--text-primary);\r\n  transform: translateX(2px);\r\n}\r\n\r\n.sidebar-nav-item.active {\r\n  background-color: var(--primary-50);\r\n  color: var(--primary-700);\r\n  font-weight: 700;\r\n  transform: translateX(3px);\r\n  box-shadow: 0 1px 3px rgba(29, 78, 216, 0.08);\r\n}\r\n\r\n.sidebar-nav-item.active::before {\r\n  content: '';\r\n  position: absolute;\r\n  left: 0;\r\n  top: 15%;\r\n  bottom: 15%;\r\n  width: 3.5px;\r\n  background-color: var(--primary);\r\n  border-radius: 0 4px 4px 0;\r\n  animation: shiftPillGrow 0.2s ease-out;\r\n}\r\n\r\n@keyframes shiftPillGrow {\r\n  from {\r\n    transform: scaleY(0);\r\n  }\r\n\r\n  to {\r\n    transform: scaleY(1);\r\n  }\r\n}\r\n\r\n/* Bento Grids */\r\n.bento-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(1, 1fr);\r\n  gap: 1rem;\r\n}\r\n\r\n@media (min-width: 640px) {\r\n  .bento-grid {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n}\r\n\r\n@media (min-width: 1024px) {\r\n  .bento-grid-4 {\r\n    grid-template-columns: repeat(4, 1fr);\r\n  }\r\n\r\n  .bento-grid-3 {\r\n    grid-template-columns: repeat(3, 1fr);\r\n  }\r\n}\r\n\r\n/* Custom Scrollbars */\r\n::-webkit-scrollbar {\r\n  width: 6px;\r\n  height: 6px;\r\n}\r\n\r\n::-webkit-scrollbar-track {\r\n  background: transparent;\r\n}\r\n\r\n::-webkit-scrollbar-thumb {\r\n  background: var(--surface-high);\r\n  border-radius: var(--radius-full);\r\n}\r\n\r\n::-webkit-scrollbar-thumb:hover {\r\n  background: var(--surface-highest);\r\n}\r\n\r\n/* ==========================================================================\r\n   Quick Actions & Quick Display Components\r\n   ========================================================================== */\r\n\r\n.quick-actions-container {\r\n  background-color: var(--surface);\r\n  border: 1px solid var(--border-subtle);\r\n  border-radius: var(--radius-2xl);\r\n  padding: 0.85rem 1.15rem;\r\n  box-shadow: var(--shadow-sm);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.65rem;\r\n}\r\n\r\n.quick-actions-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n}\r\n\r\n.quick-actions-title {\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  color: var(--text-muted);\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.06em;\r\n}\r\n\r\n.quick-actions-hint {\r\n  font-size: 11px;\r\n  color: var(--primary);\r\n  font-weight: 600;\r\n}\r\n\r\n.quick-actions-bar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n  overflow-x: auto;\r\n  padding-bottom: 2px;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.quick-action-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n  padding: 0.5rem 0.85rem;\r\n  background-color: var(--surface-low);\r\n  border: 1px solid var(--border-subtle);\r\n  border-radius: var(--radius-xl);\r\n  color: var(--text-primary);\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  white-space: nowrap;\r\n  transition: all 0.15s ease;\r\n  user-select: none;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.quick-action-btn:hover {\r\n  background-color: #EFF6FF;\r\n  border-color: #93C5FD;\r\n  color: #1D4ED8;\r\n  transform: translateY(-1px);\r\n  box-shadow: 0 2px 8px rgba(29, 78, 216, 0.12);\r\n}\r\n\r\n.quick-action-btn:active {\r\n  transform: translateY(0) scale(0.98);\r\n}\r\n\r\n.quick-action-btn.qa-btn-accent {\r\n  background-color: var(--primary-container);\r\n  border-color: #BFDBFE;\r\n  color: var(--primary);\r\n}\r\n\r\n.quick-action-btn.qa-btn-accent:hover {\r\n  background-color: #DBEAFE;\r\n  border-color: #60A5FA;\r\n  color: #1E40AF;\r\n  transform: translateY(-1px);\r\n  box-shadow: 0 3px 10px rgba(29, 78, 216, 0.18);\r\n}\r\n\r\n.qa-icon-wrapper {\r\n  width: 26px;\r\n  height: 26px;\r\n  border-radius: var(--radius-md);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.qa-icon-blue {\r\n  background-color: #DBEAFE;\r\n  color: #1D4ED8;\r\n}\r\n\r\n.qa-icon-emerald {\r\n  background-color: #D1FAE5;\r\n  color: #059669;\r\n}\r\n\r\n.qa-icon-amber {\r\n  background-color: #FEF3C7;\r\n  color: #D97706;\r\n}\r\n\r\n.qa-icon-indigo {\r\n  background-color: #E0E7FF;\r\n  color: #4338CA;\r\n}\r\n\r\n.qa-icon-rose {\r\n  background-color: #FFE4E6;\r\n  color: #E11D48;\r\n}\r\n\r\n.qa-icon-purple {\r\n  background-color: #F3E8FF;\r\n  color: #7E22CE;\r\n}\r\n\r\n.qa-icon-slate {\r\n  background-color: #E2E8F0;\r\n  color: #475569;\r\n}\r\n\r\n.qa-label {\r\n  font-weight: 600;\r\n}\r\n\r\n/* Quick Display Grid */\r\n.quick-display-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\r\n  gap: 1.25rem;\r\n  width: 100%;\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* Universal Table & Responsive Wrapper */\r\n.table-responsive {\r\n  width: 100%;\r\n  max-width: 100%;\r\n  overflow-x: auto;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  text-align: left;\r\n}\r\n\r\n.table th {\r\n  padding: 0.75rem 1rem;\r\n  font-weight: 700;\r\n  font-size: 12px;\r\n  color: var(--text-secondary);\r\n  border-bottom: 1px solid var(--border-subtle);\r\n  background-color: var(--surface-low);\r\n  white-space: nowrap;\r\n}\r\n\r\n.table td {\r\n  padding: 0.85rem 1rem;\r\n  font-size: 13px;\r\n  color: var(--text-primary);\r\n  border-bottom: 1px solid var(--border-subtle);\r\n  vertical-align: middle;\r\n}\r\n\r\n.table tr:hover td {\r\n  background-color: rgba(241, 245, 249, 0.6);\r\n}\r\n\r\n.quick-display-card {\r\n  background-color: var(--surface);\r\n  border: 1px solid var(--border-subtle);\r\n  border-radius: var(--radius-2xl);\r\n  padding: 1rem 1.15rem;\r\n  box-shadow: var(--shadow-sm);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.75rem;\r\n  min-width: 0;\r\n}\r\n\r\n.quick-display-card-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n}\r\n\r\n.qd-badge-pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.35rem;\r\n  padding: 0.2rem 0.55rem;\r\n  border-radius: var(--radius-full);\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.04em;\r\n}\r\n\r\n.qd-badge-blue {\r\n  background-color: #EFF6FF;\r\n  color: #1D4ED8;\r\n}\r\n\r\n.qd-badge-amber {\r\n  background-color: #FFFBEB;\r\n  color: #B45309;\r\n}\r\n\r\n.qd-badge-rose {\r\n  background-color: #FFF1F2;\r\n  color: #BE123C;\r\n}\r\n\r\n.quick-display-schedule-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.45rem;\r\n}\r\n\r\n.qd-schedule-item {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0.45rem 0.65rem;\r\n  border-radius: var(--radius-lg);\r\n  background-color: var(--surface-low)