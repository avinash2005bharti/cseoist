  align-items: center;\r\n  gap: 6px;\r\n  background-color: #1E293B;\r\n  color: #93C5FD;\r\n  padding: 3px 10px;\r\n  border-radius: 9999px;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.02em;\r\n  margin-bottom: 0.65rem;\r\n  width: fit-content;\r\n}\r\n\r\n.hod-greeting-title {\r\n  font-size: 24px;\r\n  font-weight: 800;\r\n  color: #0F172A;\r\n  margin: 0 0 0.35rem 0;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  line-height: 1.25;\r\n}\r\n\r\n.hod-greeting-sub {\r\n  font-size: 13.5px;\r\n  color: #64748B;\r\n  margin: 0 0 0.85rem 0;\r\n  font-weight: 500;\r\n}\r\n\r\n.hod-time-pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 12px;\r\n  color: #475569;\r\n  font-weight: 600;\r\n  background: #FFFFFF;\r\n  border: 1px solid #E2E8F0;\r\n  padding: 4px 12px;\r\n  border-radius: 8px;\r\n  width: fit-content;\r\n  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);\r\n}\r\n\r\n/* Campus Building Banner Card */\r\n.hod-campus-card {\r\n  position: relative;\r\n  border-radius: 16px;\r\n  overflow: hidden;\r\n  background-size: cover;\r\n  background-position: center;\r\n  min-height: 130px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 1.25rem 1.75rem;\r\n  border: 1px solid #CBD5E1;\r\n  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);\r\n}\r\n\r\n.hod-campus-overlay {\r\n  position: absolute;\r\n  inset: 0;\r\n  background: linear-gradient(90deg, rgba(15, 23, 42, 0.88) 0%, rgba(15, 23, 42, 0.65) 45%, rgba(15, 23, 42, 0.2) 100%);\r\n}\r\n\r\n.hod-campus-content {\r\n  position: relative;\r\n  z-index: 2;\r\n  color: #FFFFFF;\r\n  max-width: 60%;\r\n}\r\n\r\n.hod-campus-quote {\r\n  font-size: 13.5px;\r\n  font-weight: 700;\r\n  font-style: italic;\r\n  line-height: 1.4;\r\n  margin: 0 0 4px 0;\r\n  color: #F8FAFC;\r\n}\r\n\r\n.hod-campus-tag {\r\n  font-size: 11.5px;\r\n  font-weight: 600;\r\n  color: #94A3B8;\r\n  margin: 0;\r\n}\r\n\r\n.hod-academic-year-pill {\r\n  position: relative;\r\n  z-index: 2;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  background-color: rgba(15, 23, 42, 0.75);\r\n  backdrop-filter: blur(8px);\r\n  color: #FFFFFF;\r\n  padding: 6px 14px;\r\n  border-radius: 9999px;\r\n  font-size: 11.5px;\r\n  font-weight: 700;\r\n  border: 1px solid rgba(255, 255, 255, 0.25);\r\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n/* Top 6 Metric Cards */\r\n.hod-metrics-grid-top {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, 1fr);\r\n  gap: 1rem;\r\n}\r\n\r\n@media (max-width: 1400px) {\r\n  .hod-metrics-grid-top {\r\n    grid-template-columns: repeat(3, 1fr);\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .hod-metrics-grid-top {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .hod-metrics-grid-top {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n.hod-stat-card {\r\n  background-color: #FFFFFF;\r\n  border: 1px solid #E2E8F0;\r\n  border-radius: 14px;\r\n  padding: 1rem 1.15rem;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);\r\n  transition: all 0.2s ease;\r\n  position: relative;\r\n}\r\n\r\n.hod-stat-card:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);\r\n  border-color: #CBD5E1;\r\n}\r\n\r\n.hod-stat-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  margin-bottom: 0.5rem;\r\n}\r\n\r\n.hod-stat-label {\r\n  font-size: 12.5px;\r\n  font-weight: 600;\r\n  color: #475569;\r\n}\r\n\r\n.hod-stat-icon-box {\r\n  width: 34px;\r\n  height: 34px;\r\n  border-radius: 9px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.hod-stat-value {\r\n  font-size: 24px;\r\n  font-weight: 800;\r\n  color: #0F172A;\r\n  line-height: 1.15;\r\n  margin-bottom: 0.35rem;\r\n}\r\n\r\n.hod-stat-footer {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 4px;\r\n}\r\n\r\n.hod-stat-trend {\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 3px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.hod-sparkline-svg {\r\n  width: 60px;\r\n  height: 20px;\r\n  overflow: visible;\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* Middle Section: 3-Column Layout */\r\n.hod-middle-grid {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1.35fr 1.15fr;\r\n  gap: 1rem;\r\n}\r\n\r\n@media (max-width: 1200px) {\r\n  .hod-middle-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n.hod-panel-card {\r\n  background-color: #FFFFFF;\r\n  border: 1px solid #E2E8F0;\r\n  border-radius: 14px;\r\n  padding: 1.15rem 1.25rem;\r\n  display: flex;\r\n  flex-direction: column;\r\n  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);\r\n  min-width: 0;\r\n  max-width: 100%;\r\n}\r\n\r\n.hod-panel-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  margin-bottom: 1rem;\r\n  padding-bottom: 0.5rem;\r\n  border-bottom: 1px solid #F1F5F9;\r\n}\r\n\r\n.hod-panel-title-group {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.hod-panel-title {\r\n  font-size: 14.5px;\r\n  font-weight: 700;\r\n  color: #0F172A;\r\n  margin: 0;\r\n}\r\n\r\n.hod-panel-link {\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  color: #2563EB;\r\n  text-decoration: none;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  transition: color 0.15s ease;\r\n}\r\n\r\n.hod-panel-link:hover {\r\n  color: #1D4ED8;\r\n  text-decoration: underline;\r\n}\r\n\r\n/* Donut Chart Layout */\r\n.hod-donut-container {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 1rem;\r\n  flex: 1;\r\n}\r\n\r\n.hod-donut-svg-wrapper {\r\n  position: relative;\r\n  width: 140px;\r\n  height: 140px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.hod-donut-legend-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.25rem;\r\n  flex: 1;\r\n}\r\n\r\n.hod-legend-item {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  font-size: 11.5px;\r\n}\r\n\r\n/* Section Overview (CSE Only - 4 Cards Grid) */\r\n.hod-sections-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n  gap: 0.75rem;\r\n  flex: 1;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .hod-sections-grid {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n}\r\n\r\n.hod-section-tile {\r\n  border-radius: 12px;\r\n  padding: 1rem 0.75rem;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  text-align: center;\r\n  border: 1px solid transparent;\r\n  transition: all 0.15s ease;\r\n}\r\n\r\n.hod-section-tile:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);\r\n}\r\n\r\n.hod-section-icon-box {\r\n  width: 32px;\r\n  height: 32px;\r\n  border-radius: 8px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  margin-bottom: 0.5rem;\r\n}\r\n\r\n.hod-section-name {\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  color: #0F172A;\r\n  margin-bottom: 0.25rem;\r\n}\r\n\r\n.hod-section-count {\r\n  font-size: 18px;\r\n  font-weight: 800;\r\n  color: #0F172A;\r\n  line-height: 1.1;\r\n}\r\n\r\n.hod-section-subtext {\r\n  font-size: 10.5px;\r\n  color: #64748B;\r\n  margin-bottom: 0.5rem;\r\n}\r\n\r\n.hod-section-active-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  padding: 2px 8px;\r\n  border-radius: 9999px;\r\n  font-size: 10.5px;\r\n  font-weight: 700;\r\n  background-color: #ECFDF5;\r\n  color: #059669;\r\n  border: 1px solid #A7F3D0;\r\n}\r\n\r\n/* Notice Board */\r\n.hod-notices-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.65rem;\r\n  flex: 1;\r\n}\r\n\r\n.hod-notice-row {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0.65rem 0.75rem;\r\n  border-radius: 10px;\r\n  background-color: #F8FAFC;\r\n  border: 1px solid #F1F5F9;\r\n  transition: all 0.15s ease;\r\n  gap: 0.65rem;\r\n  cursor: pointer;\r\n}\r\n\r\n.hod-notice-row:hover {\r\n  background-color: #FFFFFF;\r\n  border-color: #CBD5E1;\r\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);\r\n}\r\n\r\n.hod-notice-left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.65rem;\r\n  min-width: 0;\r\n  flex: 1;\r\n}\r\n\r\n.hod-notice-icon-box {\r\n  width: 32px;\r\n  height: 32px;\r\n  border-radius: 8px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.hod-notice-meta {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n\r\n.hod-notice-title {\r\n  font-size: 12.5px;\r\n  font-weight: 700;\r\n  color: #0F172A;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.hod-notice-sub {\r\n  font-size: 10.5px;\r\n  color: #64748B;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.hod-notice-right {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.hod-notice-date {\r\n  font-size: 11px;\r\n  color: #64748B;\r\n  font-weight: 500;\r\n}\r\n\r\n.hod-notice-tag {\r\n  padding: 2px 7px;\r\n  border-radius: 6px;\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.02em;\r\n}\r\n\r\n/* 5-Column Metric Cards Row */\r\n.hod-metrics-grid-bottom {\r\n  display: grid;\r\n  grid-template-columns: repeat(5, 1fr);\r\n  gap: 1rem;\r\n}\r\n\r\n@media (max-width: 1200px) {\r\n  .hod-metrics-grid-bottom {\r\n    grid-template-columns: repeat(3, 1fr);\r\n  }\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .hod-metrics-grid-bottom {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n/* Bottom 2-Column Section */\r\n.hod-bottom-grid {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1.55fr) minmax(0, 1.15fr);\r\n  gap: 1rem;\r\n  min-wi