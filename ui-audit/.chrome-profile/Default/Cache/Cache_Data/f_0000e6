: var(--text-secondary);\n  font-size: var(--text-xs);\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.ai-sidebar-nav-btn.active {\n  border-bottom-color: var(--primary-600);\n  color: var(--primary-700);\n  font-weight: 700;\n  background-color: var(--primary-50);\n}\n\n.ai-sidebar-nav-btn:hover {\n  color: var(--text-primary);\n  background-color: var(--surface-low);\n}\n\n.ai-bubble-user {\n  background-color: var(--primary-700);\n  color: #FFFFFF !important;\n  padding: 1rem 1.25rem;\n  border-radius: var(--radius-2xl) var(--radius-2xl) 4px var(--radius-2xl);\n  box-shadow: var(--shadow-sm);\n  line-height: var(--leading-relaxed);\n  font-size: var(--text-sm);\n}\n\n.ai-bubble-user * {\n  color: #FFFFFF !important;\n}\n\n.ai-bubble-user .ai-prose,\n.ai-bubble-user .ai-prose p,\n.ai-bubble-user .ai-prose span,\n.ai-bubble-user .ai-prose strong,\n.ai-bubble-user .ai-prose em,\n.ai-bubble-user .ai-prose li {\n  color: #FFFFFF !important;\n}\n\n.ai-bubble-user .ai-prose code {\n  background-color: rgba(255, 255, 255, 0.2) !important;\n  color: #FFFFFF !important;\n  border-color: rgba(255, 255, 255, 0.3) !important;\n}\n\n.ai-bubble-assistant {\n  background-color: var(--surface);\n  color: var(--text-primary);\n  padding: 1.25rem 1.5rem;\n  border-radius: var(--radius-2xl) var(--radius-2xl) var(--radius-2xl) 4px;\n  box-shadow: var(--shadow-sm);\n  border: 1px solid var(--border-subtle);\n  line-height: var(--leading-relaxed);\n  font-size: var(--text-sm);\n}\n\n.ai-prose {\n  font-size: var(--text-sm);\n  color: var(--text-primary);\n  line-height: 1.65;\n}\n\n.ai-prose h1,\n.ai-prose h2,\n.ai-prose h3,\n.ai-prose h4 {\n  font-family: var(--font-heading);\n  color: var(--text-primary);\n  font-weight: 700;\n  margin-top: 1rem;\n  margin-bottom: 0.5rem;\n  line-height: var(--leading-snug);\n}\n\n.ai-prose h1 {\n  font-size: var(--text-xl);\n}\n\n.ai-prose h2 {\n  font-size: var(--text-lg);\n}\n\n.ai-prose h3 {\n  font-size: var(--text-base);\n}\n\n.ai-prose h4 {\n  font-size: var(--text-sm);\n}\n\n.ai-prose p {\n  margin-bottom: 0.75rem;\n}\n\n.ai-prose p:last-child {\n  margin-bottom: 0;\n}\n\n.ai-prose ul,\n.ai-prose ol {\n  padding-left: 1.25rem;\n  margin-bottom: 0.75rem;\n}\n\n.ai-prose li {\n  margin-bottom: 0.25rem;\n}\n\n.ai-prose table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: var(--text-xs);\n  margin: 0.75rem 0;\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-md);\n  overflow: hidden;\n}\n\n.ai-prose th {\n  background-color: var(--surface-low);\n  padding: 8px 12px;\n  text-align: left;\n  font-weight: 700;\n  color: var(--text-primary);\n  border-bottom: 1px solid var(--border-subtle);\n  border-right: 1px solid var(--border-subtle);\n}\n\n.ai-prose td {\n  padding: 8px 12px;\n  border-bottom: 1px solid var(--border-subtle);\n  border-right: 1px solid var(--border-subtle);\n  color: var(--text-secondary);\n}\n\n.ai-prose code:not(pre code) {\n  background-color: var(--surface-low);\n  color: var(--primary-700);\n  padding: 2px 6px;\n  border-radius: var(--radius-sm);\n  font-size: 0.85em;\n  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;\n  border: 1px solid var(--border-subtle);\n}\n\n.ai-prose pre {\n  background-color: var(--slate-900);\n  color: var(--slate-100);\n  padding: 1rem;\n  border-radius: var(--radius-xl);\n  overflow-x: auto;\n  font-size: var(--text-xs);\n  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;\n  margin: 0.75rem 0;\n}\n\n.ai-input-container {\n  display: flex;\n  align-items: flex-end;\n  gap: 0.75rem;\n  background-color: var(--surface);\n  border: 1.5px solid var(--border-default);\n  border-radius: var(--radius-xl);\n  padding: 0.65rem 0.85rem;\n  box-shadow: var(--shadow-xs);\n  transition: all 0.2s ease;\n}\n\n.ai-input-container:focus-within {\n  border-color: var(--primary);\n  box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.12);\n}\n\n/* ==========================================================================\n   New Modern Admin Dashboard (White Theme System)\n   ========================================================================== */\n\n.admin-dash-wrapper {\n  display: flex;\n  flex-direction: column;\n  gap: 1.25rem;\n  padding: 0.25rem 0.5rem 2rem;\n  background-color: #F8FAFC;\n  min-height: calc(100vh - var(--header-height));\n}\n\n/* Header Banner */\n.admin-header-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 1rem;\n}\n\n.admin-header-greeting h1 {\n  font-size: 26px;\n  font-weight: 800;\n  color: #0F172A;\n  margin: 0;\n  letter-spacing: -0.02em;\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.admin-header-greeting p {\n  font-size: 13.5px;\n  color: #64748B;\n  margin: 4px 0 0;\n  font-weight: 500;\n}\n\n.admin-header-widgets {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  flex-wrap: wrap;\n}\n\n.admin-widget-card {\n  display: flex;\n  align-items: center;\n  gap: 0.65rem;\n  background: #FFFFFF;\n  border: 1px solid #E2E8F0;\n  border-radius: 14px;\n  padding: 0.45rem 0.85rem;\n  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);\n}\n\n.admin-widget-icon {\n  width: 32px;\n  height: 32px;\n  border-radius: 10px;\n  background-color: #F1F5F9;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #475569;\n  flex-shrink: 0;\n}\n\n.admin-role-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.5rem 1rem;\n  border-radius: 14px;\n  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);\n  color: #FFFFFF;\n  font-size: 13px;\n  font-weight: 700;\n  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25);\n  border: none;\n  cursor: default;\n}\n\n/* Metric Cards Grids */\n.admin-metrics-grid-top {\n  display: grid;\n  grid-template-columns: repeat(6, 1fr);\n  gap: 0.9rem;\n}\n\n.admin-metrics-grid-bottom {\n  display: grid;\n  grid-template-colum