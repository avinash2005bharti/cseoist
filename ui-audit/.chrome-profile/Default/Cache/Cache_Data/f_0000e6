idth: 1300px) {\n  .admin-middle-grid {\n    grid-template-columns: 1fr 1fr;\n  }\n}\n\n@media (max-width: 900px) {\n  .admin-middle-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n.admin-panel-card {\n  background: #FFFFFF;\n  border: 1px solid #E2E8F0;\n  border-radius: 18px;\n  padding: 1.25rem;\n  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);\n  display: flex;\n  flex-direction: column;\n}\n\n.admin-panel-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 1rem;\n  gap: 0.5rem;\n}\n\n.admin-panel-title {\n  font-size: 15px;\n  font-weight: 700;\n  color: #0F172A;\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  margin: 0;\n}\n\n.admin-panel-subtitle {\n  font-size: 12px;\n  color: #64748B;\n  margin: 2px 0 0;\n}\n\n.admin-panel-action {\n  font-size: 12px;\n  font-weight: 600;\n  color: #2563EB;\n  text-decoration: none;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  gap: 2px;\n  transition: opacity 0.15s ease;\n}\n\n.admin-panel-action:hover {\n  text-decoration: underline;\n  opacity: 0.85;\n}\n\n/* Quick Actions Tiles */\n.admin-quick-actions-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 0.65rem;\n  flex: 1;\n}\n\n.admin-quick-action-tile {\n  display: flex;\n  align-items: center;\n  gap: 0.65rem;\n  padding: 0.75rem 0.85rem;\n  border-radius: 14px;\n  border: 1px solid transparent;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  text-decoration: none;\n}\n\n.admin-quick-action-tile:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);\n}\n\n.admin-tile-icon-box {\n  width: 34px;\n  height: 34px;\n  border-radius: 10px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.admin-tile-content {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n\n.admin-tile-title {\n  font-size: 12.5px;\n  font-weight: 700;\n  color: #0F172A;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.admin-tile-hint {\n  font-size: 10.5px;\n  font-weight: 600;\n  margin-top: 1px;\n}\n\n/* Bottom Section 2-column Layout */\n.admin-bottom-grid {\n  display: grid;\n  grid-template-columns: 1.25fr 1fr;\n  gap: 1rem;\n}\n\n@media (max-width: 1100px) {\n  .admin-bottom-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n/* Activity Table */\n.admin-activity-table {\n  width: 100%;\n  border-collapse: separate;\n  border-spacing: 0;\n  font-size: 12.5px;\n}\n\n.admin-activity-table th {\n  text-align: left;\n  padding: 0.5rem 0.75rem 0.65rem;\n  font-size: 11px;\n  font-weight: 700;\n  color: #64748B;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  border-bottom: 1px solid #E2E8F0;\n}\n\n.admin-activity-table td {\n  padding: 0.75rem 0.75rem;\n  border-bottom: 1px solid #F1F5F9;\n  vertical-align: middle;\n}\n\n.admin-activity-table tr:last-child td {\n  border-bottom: none;\n}\n\n.admin-activity-table tr:hover td {\n  background-color: #F8FAFC;\n}\n\n/* Agent List */\n.admin-agents-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.65rem;\n}\n\n.admin-agent-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0.65rem 0.75rem;\n  border-radius: 12px;\n  background-color: #F8FAFC;\n  border: 1px solid #E2E8F0;\n  transition: all 0.15s ease;\n  gap: 0.5rem;\n}\n\n.admin-agent-row:hover {\n  background-color: #FFFFFF;\n  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);\n  border-color: #CBD5E1;\n}\n\n.admin-agent-info {\n  display: flex;\n  align-items: center;\n  gap: 0.65rem;\n  min-width: 0;\n}\n\n.admin-agent-avatar {\n  width: 32px;\n  height: 32px;\n  border-radius: 9px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.admin-agent-meta {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n\n.admin-agent-name {\n  font-size: 12.5px;\n  font-weight: 700;\n  color: #0F172A;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.admin-agent-desc {\n  font-size: 10.5px;\n  color: #64748B;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.admin-agent-badges {\n  display: flex;\n  align-items: center;\n  gap: 0.45rem;\n  flex-shrink: 0;\n}\n\n.admin-badge-active {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 2px 8px;\n  border-radius: 6px;\n  font-size: 10.5px;\n  font-weight: 700;\n  background-color: #ECFDF5;\n  color: #059669;\n  border: 1px solid #A7F3D0;\n}\n\n.admin-badge-tasks {\n  font-size: 11px;\n  font-weight: 600;\n  color: #475569;\n  white-space: nowrap;\n}\n\n.admin-badge-uptime {\n  font-size: 11px;\n  font-weight: 600;\n  color: #0F172A;\n  white-space: nowrap;\n}\n\n/* ==========================================================================\n   HOD Modern Departmental Dashboard (Crisp White Theme)\n   Matches the design reference:\n   1. Header row with HOD greeting & OIST Campus Building banner card\n   2. 6 Top Metric Cards with live sparkline wave curves\n   3. 3-Column Middle section:\n      - Semester Distribution (Donut Chart)\n      - Section Overview (CSE Only - 4 Section cards)\n      - Notice Board (Official Circulars)\n   4. 5-Column Second row Metric Cards\n   5. 2-Column Bottom section:\n      - Faculty Availability Status Today (Table with duty badges)\n      - Quick Actions (2x3 colorful grid)\n   ========================================================================== */\n\n.hod-dash-wrapper {\n  padding: 1.5rem 2rem;\n  background-color: #F8FAFC;\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n  gap: 1.25rem;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n  color: #0F172A;\n}\n\n@media (max-width: 768px) {\n  .hod-dash-wrapper {\n    padding: 1rem;\n    gap: 1rem;\n  }\n}\n\n/* Header Banner */\n.hod-header-banner {\n  display: grid;\n  grid-template-columns: 1fr 1.35fr;\n  gap: 1.25rem;\n  align-items: stretch;\n}\n\n@media (max-width: 1024px) {\n  .hod-header-banner {\n    grid-template-columns: 1fr;\n  }\n}\n\n.hod-greeting-card {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  padding: 1rem 0.5rem;\n}\n\n.hod-office-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  background-color: #1E293B;\n  color: #93C5FD;\n  padding: 3px 10px;\n  border-radius: 9999px;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n  margin-bottom: 0.65rem;\n  width: fit-content;\n}\n\n.hod-greeting-title {\n  font-size: 24px;\n  font-weight: 800;\n  color: #0F172A;\n  margin: 0 0 0.35rem 0;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  line-height: 1.25;\n}\n\n.hod-greeting-sub {\n  font-size: 13.5px;\n  color: #64748B;\n  margin: 0 0 0.85rem 0;\n  font-weight: 500;\n}\n\n.hod-time-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 12px;\n  color: #475569;\n  font-weight: 600;\n  background: #FFFFFF;\n  border: 1px solid #E2E8F0;\n  padding: 4px 12px;\n  border-radius: 8px;\n  width: fit-content;\n  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);\n}\n\n/* Campus Building Banner Card */\n.hod-campus-card {\n  position: relative;\n  border-radius: 16px;\n  overflow: hidden;\n  background-size: cover;\n  background-position: center;\n  min-height: 130px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 1.25rem 1.75rem;\n  border: 1px solid #CBD5E1;\n  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);\n}\n\n.hod-campus-overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(90deg, rgba(15, 23, 42, 0.88) 0%, rgba(15, 23, 42, 0.65) 45%, rgba(15, 23, 42, 0.2) 100%);\n}\n\n.hod-campus-content {\n  position: relative;\n  z-index: 2;\n  color: #FFFFFF;\n  max-width: 60%;\n}\n\n.hod-campus-quote {\n  font-size: 13.5px;\n  font-weight: 700;\n  font-style: italic;\n  line-height: 1.4;\n  margin: 0 0 4px 0;\n  color: #F8FAFC;\n}\n\n.hod-campus-tag {\n  font-size: 11.5px;\n  font-weight: 600;\n  color: #94A3B8;\n  margin: 0;\n}\n\n.hod-academic-year-pill {\n  position: relative;\n  z-index: 2;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  background-color: rgba(15, 23, 42, 0.75);\n  backdrop-filter: blur(8px);\n  color: #FFFFFF;\n  padding: 6px 14px;\n  border-radius: 9999px;\n  font-size: 11.5px;\n  font-weight: 700;\n  border: 1px solid rgba(255, 255, 255, 0.25);\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);\n}\n\n/* Top 6 Metric Cards */\n.hod-metrics-grid-top {\n  display: grid;\n  grid-template-columns: repeat(6, 1fr);\n  gap: 1rem;\n}\n\n@media (max-width: 1400px) {\n  .hod-metrics-grid-top {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n\n@media (max-width: 768px) {\n  .hod-metrics-grid-top {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (max-width: 520px) {\n  .hod-metrics-grid-top {\n    grid-template-columns: 1fr;\n  }\n}\n\n.hod-stat-card {\n  background-color: #FFFFFF;\n  border: 1px solid #E2E8F0;\n  border-radius: 14px;\n  padding: 1rem 1.15rem;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);\n  transition: all 0.2s ease;\n  position: relative;\n}\n\n.hod-stat-card:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);\n  border-color: #CBD5E1;\n}\n\n.hod-stat-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 0.5rem;\n}\n\n.hod-stat-label {\n  font-size: 12.5px;\n  font-weight: 600;\n  color: #475569;\n}\n\n.hod-stat-icon-box {\n  width: 34px;\n  height: 34px;\n  border-radius: 9px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.hod-stat-value {\n  font-size: 24px;\n  font-weight: 800;\n  color: #0F172A;\n  line-height: 1.15;\n  margin-bottom: 0.35rem;\n}\n\n.hod-stat-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 4px;\n}\n\n.hod-stat-trend {\n  font-size: 11px;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  gap: 3px;\n  white-space: nowrap;\n}\n\n.hod-sparkline-svg {\n  width: 60px;\n  height: 20px;\n  overflow: visible;\n  flex-shrink: 0;\n}\n\n/* Middle Section: 3-Column Layout */\n.hod-middle-grid {\n  display: grid;\n  grid-template-columns: 1fr 1.35fr 1.15fr;\n  gap: 1rem;\n}\n\n@media (max-width: 1200px) {\n  .hod-middle-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n.hod-panel-card {\n  background-color: #FFFFFF;\n  border: 1px solid #E2E8F0;\n  border-radius: 14px;\n  padding: 1.15rem 1.25rem;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);\n  min-width: 0;\n  max-width: 100%;\n}\n\n.hod-panel-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 1rem;\n  padding-bottom: 0.5rem;\n  border-bottom: 1px solid #F1F5F9;\n}\n\n.hod-panel-title-group {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.hod-panel-title {\n  font-size: 14.5px;\n  font-weight: 700;\n  color: #0F172A;\n  margin: 0;\n}\n\n.hod-panel-link {\n  font-size: 12px;\n  font-weight: 600;\n  color: #2563EB;\n  text-decoration: none;\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  transition: color 0.15s ease;\n}\n\n.hod-panel-link:hover {\n  color: #1D4ED8;\n  text-decoration: underline;\n}\n\n/* Donut Chart Layout */\n.hod-donut-container {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  flex: 1;\n}\n\n.hod-donut-svg-wrapper {\n  position: relative;\n  width: 140px;\n  height: 140px;\n  flex-shrink: 0;\n}\n\n.hod-donut-legend-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  flex: 1;\n}\n\n.hod-legend-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  font-size: 11.5px;\n}\n\n/* Section Overview (CSE Only - 4 Cards Grid) */\n.hod-sections-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 0.75rem;\n  flex: 1;\n}\n\n@media (max-width: 640px) {\n  .hod-sections-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n.hod-section-tile {\n  border-radius: 12px;\n  padding: 1rem 0.75rem;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n  border: 1px solid transparent;\n  transition: all 0.15s ease;\n}\n\n.hod-section-tile:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);\n}\n\n.hod-section-icon-box {\n  width: 32px;\n  height: 32px;\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 0.5rem;\n}\n\n.hod-section-name {\n  font-size: 13px;\n  font-weight: 700;\n  color: #0F172A;\n  margin-bottom: 0.25rem;\n}\n\n.hod-section-count {\n  font-size: 18px;\n  font-weight: 800;\n  color: #0F172A;\n  line-height: 1.1;\n}\n\n.hod-section-subtext {\n  font-size: 10.5px;\n  color: #64748B;\n  margin-bottom: 0.5rem;\n}\n\n.hod-section-active-badge {\n  display: inline-flex;\n  align-items: center;\n  padding: 2px 8px;\n  border-radius: 9999px;\n  font-size: 10.5px;\n  font-weight: 700;\n  background-color: #ECFDF5;\n  color: #059669;\n  border: 1px solid #A7F3D0;\n}\n\n/* Notice Board */\n.hod-notices-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.65rem;\n  flex: 1;\n}\n\n.hod-notice-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0.65rem 0.75rem;\n  border-radius: 10px;\n  background-color: #F8FAFC;\n  border: 1px solid #F1F5F9;\n  transition: all 0.15s ease;\n  gap: 0.65rem;\n  cursor: pointer;\n}\n\n.hod-notice-row:hover {\n  background-color: #FFFFFF;\n  border-color: #CBD5E1;\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);\n}\n\n.hod-notice-left {\n  display: flex;\n  align-items: center;\n  gap: 0.65rem;\n  min-width: 0;\n  flex: 1;\n}\n\n.hod-notice-icon-box {\n  width: 32px;\n  height: 32px;\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.hod-notice-meta {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n\n.hod-notice-title {\n  font-size: 12.5px;\n  font-weight: 700;\n  color: #0F172A;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.hod-notice-sub {\n  font-size: 10.5px;\n  color: #64748B;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.hod-notice-right {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  flex-shrink: 0;\n}\n\n.hod-notice-date {\n  font-size: 11px;\n  color: #64748B;\n  font-weight: 500;\n}\n\n.hod-notice-tag {\n  padding: 2px 7px;\n  border-radius: 6px;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n}\n\n/* 5-Column Metric Cards Row */\n.hod-metrics-grid-bottom {\n  display: grid;\n  grid-template-columns: repeat(5, 1fr);\n  gap: 1rem;\n}\n\n@media (max-width: 1200px) {\n  .hod-metrics-grid-bottom {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n\n@media (max-width: 640px) {\n  .hod-metrics-grid-bottom {\n    grid-template-columns: 1fr;\n  }\n}\n\n/* Bottom 2-Column Section */\n.hod-bottom-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.55fr) minmax(0, 1.15fr);\n  gap: 1rem;\n  min-width: 0;\n  max-width: 100%;\n}\n\n@media (max-width: 1100px) {\n  .hod-bottom-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n\n/* Faculty Availability Table */\n.hod-faculty-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 12.5px;\n}\n\n.hod-faculty-table th {\n  text-align: left;\n  padding: 0.5rem 0.75rem;\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: #64748B;\n  border-bottom: 1px solid #E2E8F0;\n  white-space: nowrap;\n}\n\n.hod-faculty-table td {\n  padding: 0.65rem 0.75rem;\n  border-bottom: 1px solid #F1F5F9;\n  color: #334155;\n}\n\n.hod-faculty-table tr:hover td {\n  background-color: #F8FAFC;\n}\n\n/* Quick Actions Grid */\n.hod-quick-actions-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 0.75rem;\n  flex: 1;\n}\n\n.hod-quick-tile {\n  display: flex;\n  align-items: center;\n  gap: 0.65rem;\n  padding: 0.75rem 0.85rem;\n  border-radius: 12px;\n  border: 1px solid #E2E8F0;\n  background-color: #F8FAFC;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  text-decoration: none;\n  min-width: 0;\n}\n\n.hod-quick-tile:hover {\n  transform: translateY(-2px);\n  background-color: #FFFFFF;\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);\n}\n\n.hod-quick-tile-icon-box {\n  width: 32px;\n  height: 32px;\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.hod-quick-tile-content {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  overflow: hidden;\n}\n\n.hod-quick-tile-title {\n  font-size: 12.5px;\n  font-weight: 700;\n  color: #0F172A;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.hod-quick-tile-hint {\n  font-size: 10.5px;\n  color: #64748B;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n/* Modal for Pending Approvals Full List */\n.hod-modal-overlay {\n  position: fixed;\n  inset: 0;\n  background-color: rgba(15, 23, 42, 0.6);\n  backdrop-filter: blur(4px);\n  z-index: 9999;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 1.5rem;\n}\n\n.hod-modal-card {\n  background-color: #FFFFFF;\n  border-radius: 16px;\n  width: 100%;\n  max-width: 760px;\n  max-height: 85vh;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);\n  border: 1px solid #E2E8F0;\n  overflow: hidden;\n}\n\n.hod-modal-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 1.25rem 1.5rem;\n  border-bottom: 1px solid #F1F5F9;\n  background-