===================================================== */\n\n.app-container {\n  display: flex;\n  min-height: 100vh;\n  width: 100%;\n  position: relative;\n  overflow-x: hidden;\n}\n\n.main-content {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  width: 100%;\n  max-width: 100%;\n  background-color: var(--bg-canvas);\n  padding-bottom: 2.5rem;\n  margin-left: 0;\n  box-sizing: border-box;\n  transition: margin-left 0.28s cubic-bezier(0.16, 1, 0.3, 1), width 0.28s cubic-bezier(0.16, 1, 0.3, 1), max-width 0.28s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n@media (min-width: 1024px) {\n  .main-content.sidebar-open {\n    margin-left: var(--sidebar-width);\n    width: calc(100% - var(--sidebar-width));\n    max-width: calc(100% - var(--sidebar-width));\n  }\n\n  .main-content.sidebar-closed {\n    margin-left: 0;\n    width: 100%;\n    max-width: 100%;\n  }\n}\n\n/* Full-Window Expansive Page Container */\n.page-wrapper {\n  max-width: 100%;\n  width: 100%;\n  margin: 0;\n  padding: 1.25rem 1.25rem 5.5rem;\n  box-sizing: border-box;\n}\n\n@media (min-width: 768px) {\n  .page-wrapper {\n    padding: 1.5rem 1.75rem 5.5rem;\n  }\n}\n\n@media (min-width: 1024px) {\n  .page-wrapper {\n    padding: 1.75rem 2.25rem 6rem;\n  }\n}\n\n@media (min-width: 1440px) {\n  .page-wrapper {\n    padding: 2rem 3rem 6rem;\n  }\n}\n\n/* ==========================================================================\n   Menu Selection Design Shift & View Transitions\n   ========================================================================== */\n\n.page-shift-container {\n  width: 100%;\n  animation: pageShiftIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;\n}\n\n@keyframes pageShiftIn {\n  0% {\n    opacity: 0.3;\n    transform: translateX(16px);\n  }\n\n  100% {\n    opacity: 1;\n    transform: none;\n  }\n}\n\n/* ==========================================================================\n   Slidable Sidebar System\n   ========================================================================== */\n\n.sidebar,\n.sidebar-container {\n  position: fixed;\n  top: 0;\n  left: 0;\n  bottom: 0;\n  width: var(--sidebar-width);\n  height: 100vh;\n  height: 100dvh;\n  background-color: #FFFFFF;\n  border-right: 1px solid var(--border-subtle);\n  display: flex;\n  flex-direction: column;\n  z-index: 95;\n  transform: translateX(-100%);\n  transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;\n  box-shadow: none;\n}\n\n.sidebar.sidebar-open,\n.sidebar-container.sidebar-open {\n  transform: translateX(0);\n  box-shadow: 6px 0 28px rgba(15, 23, 42, 0.12);\n}\n\n.sidebar.sidebar-closed,\n.sidebar-container.sidebar-closed {\n  transform: translateX(-100%);\n}\n\n@media (min-width: 1024px) {\n  .sidebar.sidebar-open,\n  .sidebar-container.sidebar-open {\n    box-shadow: 1px 0 0 0 var(--border-subtle);\n  }\n}\n\n\n\n/* Nav Link Item Shift */\n.sidebar-nav-item {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0.65rem 0.85rem;\n  border-radius: var(--radius-xl);\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--text-secondary);\n  text-decoration: none;\n  transition: all 0.2s cubic-bezier(0.2, 0, 0, 1);\n  overflow: hidden;\n}\n\n.sidebar-nav-item:hover {\n  background-color: var(--slate-100);\n  color: var(--text-primary);\n  transform: translateX(2px);\n}\n\n.sidebar-nav-item.active {\n  background-color: var(--primary-50);\n  color: var(--primary-700);\n  font-weight: 700;\n  transform: translateX(3px);\n  box-shadow: 0 1px 3px rgba(29, 78, 216, 0.08);\n}\n\n.sidebar-nav-item.active::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 15%;\n  bottom: 15%;\n  width: 3.5px;\n  background-color: var(--primary);\n  border-radius: 0 4px 4px 0;\n  animation: shiftPillGrow 0.2s ease-out;\n}\n\n@keyframes shiftPillGrow {\n  from {\n    transform: scaleY(0);\n  }\n\n  to {\n    transform: scaleY(1);\n  }\n}\n\n/* Bento Grids */\n.bento-grid {\n  display: grid;\n  grid-template-columns: repeat(1, 1fr);\n  gap: 1rem;\n}\n\n@media (min-width: 640px) {\n  .bento-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (min-width: 1024px) {\n  .bento-grid-4 {\n    grid-template-columns: repeat(4, 1fr);\n  }\n\n  .bento-grid-3 {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n\n/* Custom Scrollbars */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--surface-high);\n  border-radius: var(--radius-full);\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: var(--surface-highest);\n}\n\n/* ==========================================================================\n   Quick Actions & Quick Display Components\n   ========================================================================== */\n\n.quick-actions-container {\n  background-color: var(--surface);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-2xl);\n  padding: 0.85rem 1.15rem;\n  box-shadow: var(--shadow-sm);\n  display: flex;\n  flex-direction: column;\n  gap: 0.65rem;\n}\n\n.quick-actions-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.quick-actions-title {\n  font-size: 11px;\n  font-weight: 800;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n.quick-actions-hint {\n  font-size: 11px;\n  color: var(--primary);\n  font-weight: 600;\n}\n\n.quick-actions-bar {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  overflow-x: auto;\n  padding-bottom: 2px;\n  -webkit-overflow-scrolling: touch;\n}\n\n.quick-action-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.5rem 0.85rem;\n  background-color: var(--surface-low);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-xl);\n  color: var(--text-primary);\n  font-size: 12px;\n  font-weight: 700;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: all 0.15s ease;\n  user-select: none;\n  flex-shrink: 0;\n}\n\n.quick-action-btn:hover {\n  background-color: #EFF6FF;\n  border-color: #93C5FD;\n  color: #1D4ED8;\n  transform: translateY(-1px);\n  box-shadow: 0 2px 8px rgba(29, 78, 216, 0.12);\n}\n\n.quick-action-btn:active {\n  transform: translateY(0) scale(0.98);\n}\n\n.quick-action-btn.qa-btn-accent {\n  background-color: var(--primary-container);\n  border-color: #BFDBFE;\n  color: var(--primary);\n}\n\n.quick-action-btn.qa-btn-accent:hover {\n  background-color: #DBEAFE;\n  border-color: #60A5FA;\n  color: #1E40AF;\n  transform: translateY(-1px);\n  box-shadow: 0 3px 10px rgba(29, 78, 216, 0.18);\n}\n\n.qa-icon-wrapper {\n  width: 26px;\n  height: 26px;\n  border-radius: var(--radius-md);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.qa-icon-blue {\n  background-color: #DBEAFE;\n  color: #1D4ED8;\n}\n\n.qa-icon-emerald {\n  background-color: #D1FAE5;\n  color: #059669;\n}\n\n.qa-icon-amber {\n  background-color: #FEF3C7;\n  color: #D97706;\n}\n\n.qa-icon-indigo {\n  background-color: #E0E7FF;\n  color: #4338CA;\n}\n\n.qa-icon-rose {\n  background-color: #FFE4E6;\n  color: #E11D48;\n}\n\n.qa-icon-purple {\n  background-color: #F3E8FF;\n  color: #7E22CE;\n}\n\n.qa-icon-slate {\n  background-color: #E2E8F0;\n  color: #475569;\n}\n\n.qa-label {\n  font-weight: 600;\n}\n\n/* Quick Display Grid */\n.quick-display-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 1.25rem;\n  width: 100%;\n  box-sizing: border-box;\n}\n\n/* Universal Table & Responsive Wrapper */\n.table-responsive {\n  width: 100%;\n  max-width: 100%;\n  overflow-x: auto;\n  -webkit-overflow-scrolling: touch;\n}\n\n.table {\n  width: 100%;\n  border-collapse: collapse;\n  text-align: left;\n}\n\n.table th {\n  padding: 0.75rem 1rem;\n  font-weight: 700;\n  font-size: 12px;\n  color: var(--text-secondar