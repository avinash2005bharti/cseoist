ight: 700;\n  color: var(--text-muted);\n  background-color: #FFFFFF;\n  padding: 0.15rem 0.45rem;\n  border-radius: var(--radius-md);\n  border: 1px solid var(--border-subtle);\n  flex-shrink: 0;\n}\n\n.quick-display-stat-rows {\n  display: flex;\n  flex-direction: column;\n  gap: 0.45rem;\n}\n\n.qd-stat-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0.5rem 0.65rem;\n  border-radius: var(--radius-lg);\n  background-color: var(--surface-low);\n  transition: background-color 0.15s ease;\n}\n\n.qd-stat-row:hover {\n  background-color: var(--surface-high);\n}\n\n.qd-row-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.qd-stat-count {\n  font-size: 11px;\n  font-weight: 700;\n  padding: 0.15rem 0.5rem;\n  border-radius: var(--radius-full);\n}\n\n.quick-display-alerts-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.45rem;\n}\n\n.qd-alert-box {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.5rem;\n  padding: 0.5rem 0.65rem;\n  border-radius: var(--radius-lg);\n  border: 1px solid transparent;\n  font-size: 11px;\n}\n\n.qd-alert-warning {\n  background-color: #FFFBEB;\n  border-color: #FDE68A;\n}\n\n.qd-alert-error {\n  background-color: #FFF1F2;\n  border-color: #FECDD3;\n}\n\n.qd-alert-success {\n  background-color: #ECFDF5;\n  border-color: #A7F3D0;\n}\n\n.qd-alert-info {\n  background-color: #EFF6FF;\n  border-color: #BFDBFE;\n}\n\n.qd-alert-title {\n  font-weight: 700;\n  display: block;\n  line-height: 1.25;\n}\n\n.qd-alert-desc {\n  font-size: 10px;\n  margin-top: 1px;\n  line-height: 1.3;\n}\n\n\n\n/* ==========================================================================\n   Split-Screen Login Page Styles\n   Left Half: Logos, College Name, Branding & Accreditations\n   Right Half: Authentication Form, Role Selectors & Fast Pass\n   ========================================================================== */\n\n.split-login-container {\n  display: flex;\n  min-height: 100vh;\n  width: 100%;\n  background-color: var(--bg-canvas);\n  position: relative;\n  overflow-x: hidden;\n}\n\n@media (max-width: 1023px) {\n  .split-login-container {\n    flex-direction: column;\n  }\n}\n\n/* Brand Half (Left Half) */\n.split-login-brand {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  padding: 3rem 2.5rem;\n  background: linear-gradient(135deg, #071329 0%, #0c2049 45%, #1d4ed8 100%);\n  color: #FFFFFF;\n  overflow: hidden;\n  box-sizing: border-box;\n}\n\n@media (min-width: 1024px) {\n  .split-login-brand {\n    width: 50%;\n    min-height: 100vh;\n    padding: 3.5rem 3.5rem;\n    position: sticky;\n    top: 0;\n  }\n}\n\n@media (max-width: 1023px) {\n  .split-login-brand {\n    display: none !important;\n  }\n}\n\n/* Responsive Mobile-Only Header on Login Page */\n.mobile-login-logo {\n  display: none;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n  margin-bottom: 1.5rem;\n}\n\n.mobile-logo-circle {\n  width: 76px;\n  height: 76px;\n  border-radius: var(--radius-2xl);\n  background-color: #FFFFFF;\n  padding: 0.5rem;\n  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.05);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 0.75rem;\n}\n\n.mobile-logo-circle img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n.mobile-login-logo h3 {\n  font-size: 16px;\n  font-weight: 800;\n  color: #0F172A;\n  margin: 0;\n  line-height: 1.25;\n}\n\n.mobile-login-logo p {\n  font-size: 12px;\n  color: #64748B;\n  margin-top: 3px;\n  font-weight: 500;\n}\n\n@media (max-width: 1023px) {\n  .mobile-login-logo {\n    display: flex !important;\n  }\n\n  .split-login-form-area {\n    padding: 2.5rem 1.25rem !important;\n    min-height: 100vh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n}\n\n/* Background Ambient Orbs */\n.split-login-brand::before {\n  content: '';\n  position: absolute;\n  top: -120px;\n  right: -120px;\n  width: 420px;\n  height: 420px;\n  border-radius: 50%;\n  background: radial-gradient(circle, rgba(59, 130, 246, 0.35) 0%, transparent 70%);\n  pointer-events: none;\n}\n\n.split-login-brand::after {\n  content: '';\n  position: absolute;\n  bottom: -150px;\n  left: -150px;\n  width: 500px;\n  height: 500px;\n  border-radius: 50%;\n  background: radial-gradient(circle, rgba(14, 165, 233, 0.25) 0%, transparent 70%);\n  pointer-events: none;\n}\n\n/* Brand Logo Emblem Box */\n.brand-emblem-box {\n  width: 80px;\n  height: 80px;\n  border-radius: var(--radius-2xl);\n  background-color: #FFFFFF;\n  padding: 0.65rem;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.2);\n  flex-shrink: 0;\n  transition: transform 0.2s ease;\n}\n\n.brand-emblem-box:hover {\n  transform: translateY(-2px);\n}\n\n.brand-emblem-img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n/* Accreditation Pills */\n.accreditation-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.4rem;\n  padding: 0.35rem 0.85rem;\n  border-radius: var(--radius-full);\n  background: rgba(255, 255, 255, 0.12);\n  backdrop-filter: blur(10px);\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  font-size: 11px;\n  font-weight: 600;\n  color: #E2E8F0;\n  letter-spacing: 0.02em;\n}\n\n/* Glass Feature Card */\n.brand-feature-card {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.85rem;\n  padding: 0.85rem 1rem;\n  border-radius: var(--radius-xl);\n  background: rgba(255, 255, 255, 0.07);\n  backdrop-filter: blur(12px);\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  transition: background 0.2s ease, transform 0.2s ease;\n}\n\n.brand-feature-card:hover {\n  background: rgba(255, 255, 255, 0.11);\n  transform: translateX(4px);\n}\n\n.brand-feature-icon {\n  width: 36px;\n  height: 36px;\n  border-radius: var(--radius-lg);\n  background: rgba(255, 255, 255, 0.15);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #93C5FD;\n  flex-shrink: 0;\n}\n\n/* Form Half (Right Half) */\n.split-login-form-side {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 2.5rem 1.5rem;\n  background-color: var(--bg-canvas);\n  box-sizing: border-box;\n}\n\n@media (min-width: 1024px) {\n  .split-login-form-side {\n    width: 50%;\n    min-height: 100vh;\n    padding: 3.5rem 3rem;\n  }\n}\n\n.split-form-wrapper {\n  max-width: 480px;\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  gap: 1.25rem;\n}\n\n/* Smart SSO Role Switcher Buttons on Login */\n.login-role-tab {\n  padding: 0.4rem 0.85rem;\n  border-radius: var(--radius-full);\n  font-size: 12px;\n  font-weight: 600;\n  white-space: nowrap;\n  transition: all 0.18s ease;\n  cursor: pointer;\n  border: 1px solid transparent;\n}\n\n.login-role-tab.active {\n  background-color: var(--primary);\n  color: #FFFFFF;\n  box-shadow: 0 2px 8px rgba(29, 78, 216, 0.25);\n}\n\n.login-role-tab:not(.active) {\n  background-color: var(--surface);\n  color: var(--text-secondary);\n  border-color: var(--border-subtle);\n}\n\n.login-role-tab:not(.active):hover {\n  background-color: var(--surface-high);\n  color: var(--text-primary);\n}\n\n/* ==========================================================================\n   Fixed Role Window Post-Login Header Indicator\n   ========================================================================== */\n\n.fixed-role-window-badge {\n  display: flex;\n  align-items: center;\n  gap: 0.65rem;\n  padding: 0.35rem 0.85rem;\n  border-radius: var(--radius-full);\n  background-color: var(--surface-low);\n  border: 1px solid var(--border-subtle);\n  transition: all 0.2s ease;\n}\n\n.fixed-role-window-badge:hover {\n  border-color: var(--border-focus);\n}\n\n.fixed-role-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background-color: var(--secondary);\n  box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.2);\n}\n\n.fixed-role-text {\n  display: flex;\n  flex-direction: column;\n  line-height: 1.15;\n}\n\n.fixed-role-title {\n  font-size: 12px;\n  font-weight: 800;\n  color: var(--text-primary);\n  letter-spacing: 0.02em;\n  text-transform: uppercase;\n}\n\n.fixed-role-sub {\n  font-size: 10px;\n  color: var(--primary);\n  font-weight: 600;\n}\n\n@media (max-width: 640px) {\n  .fixed-role-sub {\n    display: none;\n  }\n\n  .fixed-role-window-badge {\n    padding: 0.25rem 0.5rem;\n  }\n\n  .fixed-role-title {\n    font-size: 11px;\n  }\n}\n\n.switch-role-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n  padding: 0.35rem 0.75rem;\n  border-radius: var(--radius-full);\n  background-color: var(--surface-low);\n  border: 1px solid var(--border-subtle);\n  color: var(--text-secondary);\n  font-size: 11px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.switch-role-btn:hover {\n  background-color: var(--surface-high);\n  color: var(--text-primary);\n  border-color: var(--text-muted);\n}\n\n/* ==========================================================================\n   Fixed AI Dashboard & Dock System\n   ========================================================================== */\n\n:root {\n  --ai-dock-height: 88px;\n}\n\n/* Fixed AI Assistant Dock at bottom of screen */\n.ai-fixed-bottom-dashboard {\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  z-index: 60;\n  background: rgba(255, 255, 255, 0.88);\n  backdrop-filter: blur(20px) saturate(180%);\n  -webkit-backdrop-filter: blur(20px) saturate(180%);\n  border-top: 1px solid rgba(226, 232, 240, 0.88);\n  border-top-left-radius: 24px;\n  border-top-right-radius: 24px;\n  box-shadow: 0 -8px 24px -4px rgba(15, 23, 42, 0.08), 0 -2px 6px -1px rgba(15, 23, 42, 0.04);\n  transition: left 0.32s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s ease;\n  pointer-events: auto;\n}\n\n@media (min-width: 1024px) {\n  .ai-fixed-bottom-dashboard.sidebar-open-offset {\n    left: var(--sidebar-width);\n  }\n}\n\n.ai-dock-container {\n  max-width: 1060px;\n  margin: 0 auto;\n  width: 100%;\n  padding: 0.65rem 1.75rem 0.45rem 1.75rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.35rem;\n}\n\n@media (max-width: 1023px) {\n  .ai-dock-container {\n    padding: 0.55rem 1.25rem 0.4rem 1.25rem;\n  }\n}\n\n@media (max-width: 640px) {\n  .ai-dock-container {\n    padding: 0.45rem 0.75rem 0.35rem 0.75rem;\n  }\n\n  .ai-fixed-bottom-dashboard {\n    border-top-left-radius: 18px;\n    border-top-right-radius: 18px;\n  }\n}\n\n/* Status banner for attached file or live listening */\n.ai-dock-status-bar {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  flex-wrap: wrap;\n  padding: 0 0.25rem;\n  animation: fadeIn 0.2s ease-out;\n}\n\n.ai-attachment-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n  padding: 0.2rem 0.55rem 0.2rem 0.65rem;\n  background-color: var(--primary-container);\n  color: var(--primary);\n  border: 1px solid rgba(29, 78, 216, 0.15);\n  border-radius: var(--radius-full);\n  font-size: 11.5px;\n  max-width: 240px;\n}\n\n.ai-attachment-remove {\n  background: none;\n  border: none;\n  color: var(--text-secondary);\n  cursor: pointer;\n  padding: 2px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.15s ease;\n}\n\n.ai-attachment-remove:hover {\n  background-color: rgba(239, 68, 68, 0.15);\n  color: #DC2626;\n}\n\n.ai-listening-pulse-banner {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.45rem;\n  padding: 0.2rem 0.65rem;\n  background-color: #FEF2F2;\n  border: 1px solid #FECACA;\n  border-radius: var(--radius-full);\n  animation: pulseGlow 1.5s infinite;\n}\n\n.ai-listening-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background-color: #DC2626;\n  animation: pingDot 1s cubic-bezier(0, 0, 0.2, 1) infinite;\n}\n\n@keyframes pingDot {\n\n  75%,\n  100% {\n    transform: scale(1.6);\n    opacity: 0;\n  }\n}\n\n@keyframes pulseGlow {\n\n  0%,\n  100% {\n    box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.2);\n  }\n\n  50% {\n    box-shadow: 0 0 0 4px rgba(220, 38, 38, 0.2);\n  }\n}\n\n/* Main Form Row: 📎 | [ Type your message here... ] | 🎤 | ➤ */\n.ai-dock-form {\n  display: flex;\n  align-items: center;\n  gap: 0.45rem;\n  width: 100%;\n  background-color: rgba(248, 250, 252, 0.85);\n  border: 1px solid rgba(226, 232, 240, 0.95);\n  border-radius: 18px;\n  padding: 0.3rem 0.45rem;\n  box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.02);\n  transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;\n}\n\n.ai-dock-form:focus-within {\n  border-color: var(--primary);\n  background-color: #FFFFFF;\n  box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.12), inset 0 1px 2px rgba(15, 23, 42, 0.02);\n}\n\n/* Multiline Textarea wrapper */\n.ai-textarea-wrapper {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  align-items: center;\n}\n\n.ai-multiline-textarea {\n  width: 100%;\n  background: transparent;\n  border: none;\n  outline: none;\n  resize: none;\n  font-family: var(--font-body);\n  font-size: 13.5px;\n  line-height: 1.45;\n  color: var(--text-primary);\n  padding: 0.4rem 0.5rem;\n  min-height: 38px;\n  max-height: 120px;\n  overflow-y: auto;\n}\n\n.ai-multiline-textarea::placeholder {\n  color: #94A3B8;\n  font-size: 13px;\n}\n\n/* Dock Action Buttons */\n.ai-dock-btn {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 38px;\n  height: 38px;\n  min-width: 38px;\n  min-height: 38px;\n  border-radius: 12px;\n  border: none;\n  cursor: pointer;\n  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);\n  user-select: none;\n  flex-shrink: 0;\n}\n\n.ai-dock-btn:active {\n  transform: scale(0.94);\n}\n\n.ai-dock-btn-attach {\n  color: var(--text-secondary);\n  background-color: transparent;\n}\n\n.ai-dock-btn-attach:hover {\n  background-color: rgba(226, 232, 240, 0.8);\n  color: var(--primary);\n  transform: scale(1.05);\n}\n\n.ai-dock-btn-attach.active {\n  background-color: var(--primary-container);\n  color: var(--primary);\n}\n\n.ai-dock-btn-mic {\n  color: var(--text-secondary);\n  background-color: transparent;\n}\n\n.ai-dock-btn-mic:hover {\n  background-color: rgba(226, 232, 240, 0.8);\n  color: var(--primary);\n  transform: scale(1.05);\n}\n\n.ai-dock-btn-mic.listening {\n  background-color: #FEE2E2;\n  color: #DC2626;\n  animation: micPulse 1.2s infinite;\n}\n\n@keyframes micPulse {\n\n  0%,\n  100% {\n    transform: scale(1);\n  }\n\n  50% {\n    transform: scale(1.08);\n  }\n}\n\n.ai-dock-btn-send.enabled {\n  background-color: var(--primary);\n  color: #FFFFFF;\n  box-shadow: 0 2px 8px rgba(29, 78, 216, 0.35);\n}\n\n.ai-dock-btn-send.enabled:hover {\n  background-color: var(--primary-hover);\n  transform: scale(1.06);\n  box-shadow: 0 4px 12px rgba(29, 78, 216, 0.45);\n}\n\n.ai-dock-btn-send.disabled {\n  background-color: #E2E8F0;\n  color: #94A3B8;\n  cursor: not-allowed;\n  opacity: 0.65;\n}\n\n/* Dock Bottom Footer / Branding Row */\n.ai-dock-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 0.35rem;\n  font-size: 11px;\n}\n\n.ai-dock-branding {\n  display: flex;\n  align-items: center;\n  gap: 0.35rem;\n  color: var(--text-muted);\n  font-size: 10.5px;\n  font-weight: 600;\n}\n\n@media (max-width: 640px) {\n  .ai-dock-branding {\n    display: none;\n  }\n\n  .ai-dock-footer {\n    justify-content: flex-end;\n  }\n}\n\n.ai-history-toggle {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.3rem;\n  color: var(--primary);\n  font-size: 11px;\n  font-weight: 600;\n  cursor: pointer;\n  background: none;\n  border: none;\n  padding: 0;\n  transition: opacity 0.15s ease;\n}\n\n.ai-history-toggle:hover {\n  opacity: 0.85;\n  text-decoration: underline;\n}\n\n/* AI Assistant Response Drawer */\n.ai-response-drawer {\n  p