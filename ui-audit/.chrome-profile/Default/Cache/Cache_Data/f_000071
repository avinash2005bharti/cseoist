d\"],\r\nspan[class*=\"text-3xl\"][class*=\"font-black\"] {\r\n  font-feature-settings: 'tnum' on, 'lnum' on !important;\r\n  letter-spacing: -0.02em !important;\r\n  line-height: 1.2 !important;\r\n}\r\n\r\n/* 8. Modern SaaS Sidebar & Header Elevation (ISSUE-08) */\r\nheader.sticky {\r\n  background-color: rgba(255, 255, 255, 0.94) !important;\r\n  backdrop-filter: blur(12px) !important;\r\n  -webkit-backdrop-filter: blur(12px) !important;\r\n  border-bottom: 1px solid rgba(226, 232, 240, 0.9) !important;\r\n  box-shadow: 0 1px 2px 0 rgba(15, 23, 42, 0.03) !important;\r\n}\r\n\r\n.sidebar,\r\n.sidebar-container {\r\n  background-color: #FFFFFF !important;\r\n  border-right: 1px solid rgba(226, 232, 240, 0.9) !important;\r\n}\r\n\r\n.sidebar .nav-link {\r\n  border-radius: 8px !important;\r\n  font-weight: 500 !important;\r\n  font-size: 13.5px !important;\r\n  transition: all 0.15s ease !important;\r\n  color: #334155 !important;\r\n}\r\n\r\n.sidebar .nav-link:hover {\r\n  background-color: #F8FAFC !important;\r\n  color: #0F172A !important;\r\n}\r\n\r\n.sidebar .nav-link.active,\r\n.sidebar .nav-link.bg-blue-600 {\r\n  background: linear-gradient(180deg, #2563EB 0%, #1D4ED8 100%) !important;\r\n  color: #FFFFFF !important;\r\n  font-weight: 600 !important;\r\n  box-shadow: 0 2px 6px rgba(29, 78, 216, 0.25) !important;\r\n}\r\n\r\n.sidebar div.p-3\\.5.m-3.rounded-2xl {\r\n  background-color: #F8FAFC !important;\r\n  border: 1px solid #E2E8F0 !important;\r\n  border-radius: 12px !important;\r\n}\r\n\r\n/* 9. Data Tables & Ledgers Polish - with smooth horizontal scroll */\r\n.table-responsive {\r\n  border: 1px solid #E2E8F0 !important;\r\n  border-radius: 12px !important;\r\n  overflow-x: auto !important;\r\n  overflow-y: hidden !important;\r\n  -webkit-overflow-scrolling: touch !important;\r\n  box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.03) !important;\r\n}\r\n\r\n.table-responsive table thead,\r\n.table-responsive thead {\r\n  background-color: #F8FAFC !important;\r\n  border-bottom: 1px solid #E2E8F0 !important;\r\n}\r\n\r\n.table-responsive table th {\r\n  background-color: #F8FAFC !important;\r\n  color: #475569 !important;\r\n  font-size: 11.5px !important;\r\n  font-weight: 700 !important;\r\n  letter-spacing: 0.05em !important;\r\n  text-transform: uppercase !important;\r\n  border-bottom: 1px solid #E2E8F0 !important;\r\n  padding: 0.75rem 1rem !important;\r\n  white-space: nowrap !important;\r\n}\r\n\r\n.table-responsive table td {\r\n  padding: 0.85rem 1rem !important;\r\n  border-bottom: 1px solid #F1F5F9 !important;\r\n  color: #1E293B !important;\r\n  font-size: 13.5px !important;\r\n  vertical-align: middle !important;\r\n}\r\n\r\n.table-responsive table tr:hover td {\r\n  background-color: #F8FAFC !important;\r\n}\r\n\r\n/* 10. Filter & Action Bar Polish (ISSUE-02) */\r\ndiv.flex.flex-wrap.items-center.gap-2 {\r\n  gap: 0.5rem !important;\r\n}\r\n\r\n/* 11. Responsive Breakpoints & Mobile Verification (ISSUE-09) */\r\n@media (max-width: 639px) {\r\n  html, body {\r\n    overflow-x: hidden !important;\r\n    max-width: 100vw !important;\r\n  }\r\n\r\n  .app-container,\r\n  .page-wrapper {\r\n    max-width: 100vw !important;\r\n    overflow-x: hidden !important;\r\n    box-sizing: border-box !important;\r\n  }\r\n\r\n  /* Accessible touch targets on mobile - targeted to avoid breaking steppers and pills */\r\n  .btn:not(.btn-xs):not(.btn-sm),\r\n  .btn-primary:not(.btn-xs):not(.btn-sm),\r\n  .btn-secondary:not(.btn-xs):not(.btn-sm),\r\n  .auth-submit,\r\n  input:not([type=\"checkbox\"]):not([type=\"radio\"]):not([type=\"file\"]) {\r\n    min-height: 44px !important;\r\n  }\r\n\r\n  /* Modals mobile sizing & safe scrolling */\r\n  .modal-container,\r\n  .modal-content {\r\n    width: calc(100vw - 20px) !important;\r\n    max-height: calc(100dvh - 24px) !important;\r\n    padding: 1.15rem !important;\r\n    border-radius: 16px !important;\r\n    overflow-y: auto !important;\r\n  }\r\n\r\n  /* Grid stacking on mobile */\r\n  .grid-cols-1,\r\n  .grid-cols-2,\r\n  .grid-cols-3,\r\n  .grid-cols-4,\r\n  .grid-cols-6 {\r\n    gap: 0.85rem !important;\r\n  }\r\n}\r\n\r\n/* Modal responsive sizing overrides (fixes squashing of wide modals like Ledger, Curriculum, and Applications) */\r\n.modal-container.max-w-sm { max-width: 24rem !important; }\r\n.modal-container.max-w-md { max-width: 28rem !important; }\r\n.modal-container.max-w-lg { max-width: 32rem !important; }\r\n.modal-container.max-w-xl { max-width: 36rem !important; }\r\n.modal-container.max-w-2xl { max-width: 42rem !important; }\r\n.modal-container.max-w-3xl { max-width: 48rem !important; }\r\n.modal-container.max-w-4xl { max-width: 56rem !important; }\r\n.modal-container.max-w-5xl { max-width: 64rem !important; }\r\n.modal-container.max-w-6xl { max-width: 72rem !important; }\r\n.modal-container.max-w-7xl { max-width: 80rem !important; }\r\n\r\n\r\n/* ==========================================================================\r\n   CAMPUSFLOW MODERN SAAS REDESIGN SYSTEM (new_ui FIDELITY)\r\n   Matching Screen 1 through Screen 15 Design Language & Specifications:\r\n   1. BUTTON COLOR MANDATE: Zero green or red action buttons!\r\n      - Primary action buttons: SaaS Royal Blue / Iris (#2563EB, hover #1D4ED8)\r\n      - Outline / Secondary buttons: Crisp White (#FFFFFF, border #CBD5E1, text #334155)\r\n      - Reject / Destructive action buttons: Neutral Slate Outline (#CBD5E1, text #475569) or Solid Slate (#334155)\r\n   2. OPTION SELECTIONS: Active state #2563EB; Inactive rich Blue hover (#EFF6FF, border #BFDBFE, text #1D4ED8)\r\n   3. SCREEN SPECIFIC POLISH: Student Workspace, TG Workspace, HOD Clearances, Offline/Error\r\n   ========================================================================== */\r\n\r\n/* --------------------------------------------------------------------------\r\n   A. GLOBAL ACTION BUTTONS COLOR OVERRIDE (ZERO GREEN / ZERO RED)\r\n   -------------------------------------------------------------------------- */\r\n\r\n/* 1. Primary Solid Action Buttons that were Green (Approve, Sanction, View Order, Confirm, etc.) */\r\nbutton[class*=\"bg-emerald-600\"],\r\nbutton[class*=\"bg-emerald-700\"],\r\nbutton[class*=\"bg-emerald-800\"],\r\nbutton[class*=\"bg-green-600\"],\r\nbutton[class*=\"bg-green-700\"],\r\nbutton[class*=\"bg-emerald-500\"],\r\nbutton.bg-emerald-600,\r\nbutton.bg-emerald-700,\r\nbutton.btn-success,\r\n.btn-success,\r\nbutton:has(svg)[class*=\"bg-emerald\"] {\r\n  background: #2563EB !important;\r\n  background-color: #2563EB !important;\r\n  border: 1px solid #1D4ED8 !important;\r\n  color: #FFFFFF !important;\r\n  box-shadow: 0 1px 2px 0 rgba(37, 99, 235, 0.25) !important;\r\n  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1) !important;\r\n}\r\n\r\nbutton[class*=\"bg-emerald-600\"]:hover,\r\nbutton[class*=\"bg-emerald-700\"]:hover,\r\nbutton[class*=\"bg-emerald-800\"]:hover,\r\nbutton[class*=\"bg-green-600\"]:hover,\r\nbutton[class*=\"bg-green-700\"]:hover,\r\nbutton.bg-emerald-600:hover,\r\nbutton.bg-emerald-700:hover,\r\nbutton.btn-success:hover,\r\n.btn-success:hover {\r\n  background: #1D4ED8 !important;\r\n  background-color: #1D4ED8 !important;\r\n  border-color: #1E40AF !important;\r\n  color: #FFFFFF !important;\r\n  box-shadow: 0 4px 12px -2px rgba(37, 99, 235, 0.35) !important;\r\n  transform: translateY(-1px) !important;\r\n}\r\n\r\nbutton[class*=\"bg-emerald-600\"]:active,\r\nbutton[class*=\"bg-emerald-700\"]:active,\r\nbutton.btn-success:active {\r\n  transform: scale(0.98) !important;\r\n}\r\n\r\nbutton[class*=\"bg-emerald-600\"] svg,\r\nbutton[class*=\"bg-emerald-700\"] svg,\r\nbutton[class*=\"bg-green-600\"] svg,\r\nbutton.btn-success svg {\r\n  color: #FFFFFF !important;\r\n  stroke: #FFFFFF !important;\r\n}\r\n\r\n/* 2. Secondary / Outline Action Buttons that were Green (Attendance Clearances, Apply for Leave, etc.) */\r\nbutton[class*=\"bg-emerald-50\"],\r\nbutton[class*=\"bg-[#ECFDF5]\"],\r\nbutton[class*=\"bg-[#ecfdf5]\"],\r\nbutton[class*=\"bg-[#EFFAF3]\"],\r\nbutton[class*=\"border-emerald-300\"],\r\nbutton[class*=\"border-emerald-200\"],\r\nbutton[class*=\"border-[#A7F3D0]\"],\r\nbutton[class*=\"text-emerald-800\"],\r\nbutton[class*=\"text-emerald-700\"] {\r\n  background: #FFFFFF !important;\r\n  background-color: #FFFFFF !important;\r\n  border: 1px solid #CBD5E1 !important;\r\n  color: #0F172A !important;\r\n  box-shadow: 0 1px 2px 0 rgba(15, 23, 42, 0.04) !important;\r\n  transition: all 0.15s ease !important;\r\n}\r\n\r\nbutton[class*=\"bg-emerald-50\"]:hover,\r\nbutton[class*=\"bg-[#ECFDF5]\"]:hover,\r\nbutton[class*=\"bg-[#ecfdf5]\"]:hover,\r\nbutton[class*=\"bg-[#EFFAF3]\"]:hover,\r\nbutton[class*=\"text-emerald-800\"]:hover,\r\nbutton[class*=\"text-emerald-700\"]:hover {\r\n  background: #EFF6FF !important;\r\n  background-color: #EFF6FF !important;\r\n  border-color: #93C5FD !important;\r\n  color: #1D4ED8 !important;\r\n  box-shadow: 0 2px 6px 0 rgba(37, 99, 235, 0.1) !important;\r\n  transform: translateY(-1px) !important;\r\n}\r\n\r\nbutton[class*=\"bg-emerald-50\"] svg,\r\nbutton[class*=\"bg-[#ECFDF5]\"] svg,\r\nbutton[class*=\"bg-[#ecfdf5]\"] svg,\r\nbutton[class*=\"text-emerald-800\"] svg,\r\nbutton[class*=\"text-emerald-700\"] svg {\r\n  color: #2563EB !important;\r\n  stroke: #2563EB !important;\r\n}\r\n\r\n/* 3. Reject / Destructive Outline Buttons that were Red (Reject button on HOD / TG review) */\r\nbutton[class*=\"text-rose-600\"],\r\nbutton[class*=\"text-rose-700\"],\r\nbutton[class*=\"text-red-600\"],\r\nbutton[class*=\"border-rose-300\"],\r\nbutton[class*=\"border-rose-200\"],\r\nbutton[class*=\"bg-rose-50\"],\r\nbutton.btn-danger-outline,\r\n.btn-danger-outline {\r\n  background: #FFFFFF !important;\r\n  background-color: #FFFFFF !important;\r\n  border: 1px solid #CBD5E1 !important;\r\n  color: #475569 !important;\r\n  box-shadow: 0 1px 2px 0 rgba(15, 23, 42, 0.03) !important;\r\n  transition: all 0.15s ease !important;\r\n}\r\n\r\nbutton[class*=\"text-rose-600\"]:hover,\r\nbutton[class*=\"text-rose-700\"]:hover,\r\nbutton[class*=\"text-red-600\"]:hover,\r\nbutton[class*=\"border-rose-300\"]:hover,\r\nbutton[class*=\"border-rose-200\"]:hover,\r\nbutton[class*=\"bg-rose-50\"]:hover,\r\nbutton.btn-danger-outline:hover {\r\n  background: #F1F5F9 !important;\r\n  background-color: #F1F5F9 !important;\r\n  border-color: #94A3B8 !important;\r\n  color: #0F172A !important;\r\n  box-shadow: 0 2px 4px 0 rgba(15, 23, 42, 0.06) !important;\r\n}\r\n\r\nbutton[class*=\"text-rose-600\"] svg,\r\nbutton[class*=\"text-rose-700\"] svg,\r\nbutton[class*=\"text-red-600\"] svg,\r\nbutton.btn-danger-outline svg {\r\n  color: #64748B !important;\r\n  stroke: #64748B !important;\r\n}\r\n\r\n/* 4. Solid Destructive Buttons that were Red -> Replace with modern dark slate */\r\nbutton[class*=\"bg-rose-600\"],\r\nbutton[class*=\"bg-rose-700\"],\r\nbutton[class*=\"bg-red-600\"],\r\nbutton[class*=\"bg-red-700\"],\r\nbutton.btn-danger,\r\n.btn-danger {\r\n  background: #334155 !important;\r\n  background-color: #334155 !important;\r\n  border: 1px solid #1E293B !important;\r\n  color: #FFFFFF !important;\r\n  box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.12) !important;\r\n}\r\n\r\nbutton[class*=\"bg-rose-600\"]:hover,\r\nbutton[class*=\"bg-rose-700\"]:hover,\r\nbutton[class*=\"bg-red-600\"]:hover,\r\nbutton.btn-danger:hover,\r\n.btn-danger:hover {\r\n  background: #1E293B !important;\r\n  background-color: #1E293B !important;\r\n  border-color: #0F172A !important;\r\n  color: #FFFFFF !important;\r\n}\r\n\r\n/* 5. Override inline green styled buttons to Royal Blue (Zero Green Buttons Mandate) */\r\nbutton[style*=\"059669\"],\r\nbutton[style*=\"5, 150, 105\"],\r\nbutton[style*=\"rgb(5, 150, 105)\"] {\r\n  background: #2563EB !important;\r\n  background-color: #2563EB !important;\r\n  border-color: #1D4ED8 !important;\r\n  color: #FFFFFF !important;\r\n  box-shadow: 0 1px 2px 0 rgba(37, 99, 235, 0.25) !important;\r\n}\r\n\r\nbutton[style*=\"059669\