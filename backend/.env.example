# ==============================================================================
# CampusFlow Lite - Backend Environment Configuration Example
# Duplicate this file to .env and configure with your credentials.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# 1. MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusflow?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusflow?retryWrites=true&w=majority

# 2. JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_access_token_key_here_at_least_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here_at_least_32_chars
JWT_EXPIRE=7d

# 3. Brevo (Transactional Email API for Status Updates)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com
BREVO_SENDER_NAME="CampusFlow Notifications"
SMTP_KEY=your_brevo_smtp_key_here

# 4. ImageKit (Cloud Storage for Proof Documents, Certificates, Images & PDFs)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id/

# 5. Frontend Client URL & CORS Allowed Origins
# In production, set CLIENT_URL to your primary deployed domain (e.g. https://campusflow.yourdomain.com)
# For multiple domains or preview deployments, provide comma-separated origins in ALLOWED_ORIGINS
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# 6. Google OAuth 2.0 (Optional Single Sign-On)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 7. Web Push (VAPID Configuration for PWA Reminders)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@campusflow.edu

